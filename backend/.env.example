# Variables de entorno de ejemplo (copiar a .env y ajustar)

# Frontend
FRONTEND_URL=http://localhost:8081

# API base URL usada por el frontend al construir el bundle
API_BASE_URL=http://localhost:5001

# Bootstrap del administrador inicial (obligatorio en una base nueva; si faltan, la app falla al iniciar)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!123

# Autenticacion
AUTH_USE_LDAP=false
ALLOW_LOCAL_BREAK_GLASS=true
BREAK_GLASS_USERNAMES=ADMIN
AUTO_PROVISION_LDAP_USERS=false
DEFAULT_LDAP_ROLE=viewer

# MFA
MFA_ISSUER=Syntro
MFA_REQUIRE_FOR_ADMINS=true
MFA_REQUIRE_FOR_NON_ADMINS=false

# Politica de contrasenas (NIST; minimo 10, sin reglas de composicion)
PASSWORD_POLICY_MIN_LENGTH=10
PASSWORD_POLICY_MAX_LENGTH=64
PASSWORD_POLICY_DISALLOW_COMMON_PASSWORDS=true

# LDAP (opcional; solo si AUTH_USE_LDAP=true)
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_DOMAIN=example
LDAP_BASE_DN=DC=example,DC=com
LDAP_UPN_SUFFIXES=example.com
LDAP_USE_SSL=false
LDAP_TRUST_SERVER_CERTIFICATE=false

# Backups
BACKUP_ENABLED=true
BACKUP_PATH=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Telemetria de red (opcional; desactivada por defecto)
NETWORK_TELEMETRY_ENABLED=false
NETWORK_TELEMETRY_AUTOSCAN=false
NETWORK_TELEMETRY_TIME_ZONE=UTC
NETWORK_TELEMETRY_DISPLAY_TIME_ZONE=UTC
NETWORK_TELEMETRY_DISPLAY_LOCALE=es-CL
NETWORK_TELEMETRY_INGEST_API_KEY=CHANGE_ME

# Formulario de entrega
DELIVERY_FORM_INSTITUTION=
DELIVERY_FORM_TEMPLATE_PATH=
DELIVERY_FORM_SOFFICE_PATH=soffice
