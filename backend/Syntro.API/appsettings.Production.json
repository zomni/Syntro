{
  "AllowedOrigins": "http://localhost:8081,http://localhost:3000",
  "AuthSettings": {
    "UseLdapAuthentication": false,
    "AllowLocalBreakGlass": true,
    "BreakGlassUsernames": "ADMIN"
  },
  "DemoData": {
    "Enabled": false
  },
  "CampusSettings": {
    "DefaultCampus": ""
  },
  "MfaSettings": {
    "RequireForAdmins": true,
    "RequireForNonAdmins": false
  },
  "SecuritySettings": {
    "ForceHttps": true,
    "EnableSwaggerInProduction": false,
    "CookieSecurePolicy": "Always",
    "CookieSameSite": "Lax",
    "ReferrerPolicy": "strict-origin-when-cross-origin"
  },
  "NetworkTelemetrySettings": {
    "Enabled": false,
    "AutoScanEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
