{
  "ConnectionStrings": {
    "Default": "Data Source=syntro.db"
  },
  "AllowedOrigins": "http://localhost:8081,http://localhost:3000",
  "FrontendAppUrl": "http://localhost:8081",
  "FrontendDataRoot": "../frontend/src/data",
  "AuthSettings": {
    "UseLdapAuthentication": false,
    "AllowLocalBreakGlass": true,
    "BreakGlassUsernames": "ADMIN",
    "AutoProvisionLdapUsers": false,
    "DefaultLdapRole": "viewer"
  },
  "CampusSettings": {
    "DefaultCampus": ""
  },
  "DemoData": {
    "Enabled": false
  },
  "DeliveryForm": {
    "Institution": "",
    "TemplatePath": "",
    "SofficePath": "",
    "ApplicationChecklist": {
      "Sections": []
    }
  },
  "MfaSettings": {
    "Issuer": "Syntro",
    "RequireForAdmins": true,
    "RequireForNonAdmins": false,
    "PendingMinutes": 10,
    "PeriodSeconds": 30,
    "Digits": 6,
    "WindowSteps": 6
  },
  "LdapSettings": {
    "Host": "ldap.example.com",
    "FallbackHost": "",
    "Port": 389,
    "Domain": "example",
    "BaseDn": "DC=example,DC=com",
    "UpnSuffixes": "example.com",
    "UseSsl": false,
    "TrustServerCertificate": false
  },
  "CorsSettings": {
    "AllowedOrigins": "http://localhost:8081,http://localhost:3000"
  },
  "SecuritySettings": {
    "ForceHttps": true,
    "EnableSwaggerInProduction": false,
    "DataProtectionKeysPath": "",
    "CookieSecurePolicy": "SameAsRequest",
    "CookieSameSite": "Lax",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "ContentSecurityPolicy": "default-src \u0027self\u0027; base-uri \u0027self\u0027; object-src \u0027none\u0027; frame-ancestors \u0027none\u0027; img-src \u0027self\u0027 data: blob: https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https:; script-src \u0027self\u0027 \u0027unsafe-inline\u0027 \u0027unsafe-eval\u0027 https:; connect-src \u0027self\u0027 https: http: ws: wss:; font-src \u0027self\u0027 data: https:"
  },
  "PasswordPolicy": {
    "MinLength": 10,
    "MaxLength": 64,
    "DisallowCommonPasswords": true
  },
  "SessionSettings": {
    "IdleMinutes": 15,
    "WarningMinutes": 14,
    "RememberMeDays": 30
  },
  "BackupSettings": {
    "Enabled": true,
    "Path": "backups",
    "Cron": "",
    "IntervalHours": 24,
    "RetentionDays": 30
  },
  "NetworkTelemetrySettings": {
    "Enabled": false,
    "ExecutionMode": "agent",
    "AgentSharedPath": "../../runtime/network-telemetry-agent",
    "AgentHeartbeatTimeoutSeconds": 30,
    "AutoScanEnabled": false,
    "AutoScanIntervalMinutes": 30,
    "AutoScanCron": "",
    "AutoScanCrons": "",
    "AutoScanTimeZone": "UTC",
    "DisplayTimeZone": "UTC",
    "DisplayLocale": "es-CL",
    "ScanCidrs": "",
    "MaxRangesPerScan": 12,
    "MaxHostsPerScan": 4096,
    "MaxConcurrentProbes": 96,
    "PortProbeConcurrency": 16,
    "ScanPorts": "135,139,445,3389,80,443,22,9100,631,515,53,88,389,161,5985,5986,8080,8443",
    "PingTimeoutMs": 250,
    "TcpTimeoutMs": 250,
    "DnsTimeoutMs": 1200,
    "FreshnessMinutes": 30,
    "RetentionDays": 90,
    "MaxSnapshots": 100,
    "IngestApiKey": "CHANGE_ME"
  },
  "PdfSettings": {
    "MaxUploadBytes": 25000000,
    "AllowedMimeTypes": "application/pdf,application/x-pdf"
  },
  "MlSettings": {
    "Enabled": true,
    "ModelsPath": "ml-models",
    "ItemClassificationModelPath": "ml-models/item-classification.zip",
    "RiskPredictionModelPath": "ml-models/risk-prediction.zip",
    "ClassificationConfidenceThreshold": 0.6,
    "RiskMlWeight": 0.6,
    "RiskRuleWeight": 0.4
  },
