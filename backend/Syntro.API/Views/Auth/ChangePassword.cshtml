@model Syntro.API.ViewModels.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Cambiar contrasena";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cambiar contrasena - Syntro</title>
    <link rel="icon" type="image/svg+xml" href="/assets/branding/syntro-icon-simple.svg?v=20261030a" />
    <link rel="icon" type="image/x-icon" href="/assets/branding/favicon.ico?v=20261030a" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/branding/apple-touch-icon-180.png?v=20261030a" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root { --pi-primary: #003366; }
        body { background: linear-gradient(180deg, rgba(0,30,60,.84), rgba(0,20,40,.94)), url('/assets/branding/hospital-sotero.jpg') center/cover no-repeat; min-height: 100vh; }
        .auth-card { border-radius: 18px; background: rgba(255,255,255,.94); }
        .btn-primary { background-color: var(--pi-primary); border-color: var(--pi-primary); }
    </style>
</head>
<body>
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow-sm auth-card" style="max-width: 460px; width: 100%;">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <img src="/assets/branding/app-logo-backend.svg" alt="Syntro" style="width:72px;height:72px;border-radius:18px;" class="mb-3" />
                    <h1 class="h4 fw-bold mb-2">Cambia tu contrasena</h1>
                    <p class="text-muted mb-0">La cuenta <strong>@Model.Username</strong> requiere una nueva contrasena para continuar.</p>
                </div>
                <form method="post" action="/Auth/ChangePassword">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Nueva contrasena</label>
                        <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" autofocus />
                        <div class="form-text">Debe cumplir la politica de seguridad configurada.</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar contrasena</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar nueva contrasena</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
