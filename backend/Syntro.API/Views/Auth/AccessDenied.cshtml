@{
    Layout = null;
    ViewData["Title"] = "Acceso denegado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso denegado - Syntro Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --pi-primary: #003366;
            --pi-primary-hover: #002855;
        }
        body { background: linear-gradient(180deg, #eefaf7, #f8fafc); }
        .auth-card { border: 1px solid rgba(15, 118, 110, 0.18); border-radius: 18px; }
        .btn-primary { background-color: var(--pi-primary); border-color: var(--pi-primary); }
        .btn-primary:hover, .btn-primary:focus { background-color: var(--pi-primary-hover); border-color: var(--pi-primary-hover); }
    </style>
</head>
<body>
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow-sm auth-card" style="max-width: 520px; width: 100%;">
            <div class="card-body p-4 p-lg-5 text-center">
                <h1 class="h3 fw-bold mb-3">No tienes permisos para entrar aqui</h1>
                <p class="text-muted mb-4">Tu cuenta puede haber iniciado sesion correctamente, pero esta vista necesita privilegios de administrador.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="/admin" class="btn btn-primary">Volver al dashboard</a>
                    <a href="/Auth/Login" class="btn btn-outline-secondary">Cambiar usuario</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
