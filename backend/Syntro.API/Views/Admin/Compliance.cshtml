@{
    ViewData["Title"] = "Gestion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic compliance = ViewData.Model;
    var overallStatus = (string)(compliance.OverallStatus ?? "Advertencia");
    var statusClass = overallStatus switch
    {
        "OK" => "bg-success",
        "Critico" => "bg-danger",
        _ => "bg-warning text-dark"
    };
    var overallLabel = (string)(compliance.OverallStatusLabel ?? overallStatus);
}

<style>
    .compliance-hero {
        border: 0;
        border-radius: 22px;
        color: #fff;
        background:
            radial-gradient(circle at top right, rgba(59, 130, 246, 0.22), transparent 32%),
            linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #38bdf8 100%);
    }
    .compliance-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .compliance-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .compliance-card .card-header {
        border-bottom: 1px solid rgba(226, 232, 240, 0.7);
        padding: 1rem 1.25rem;
        position: relative;
    }
    .compliance-card .card-header::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: 0 4px 4px 0;
        background: linear-gradient(180deg, #2d79a0, #38bdf8);
    }
    .compliance-card .dashboard-kpi-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .compliance-card:hover .dashboard-kpi-icon {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .8rem;
        border-radius: 999px;
        font-weight: 700;
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .status-ok { background: rgba(34, 197, 94, .12); color: #15803d; }
    .status-warning { background: rgba(245, 158, 11, .14); color: #b45309; }
    .status-critical { background: rgba(239, 68, 68, .12); color: #b91c1c; }
    .status-active.status-ok { background: #22c55e; color: #fff; transform: scale(1.15); box-shadow: 0 0 0 3px rgba(34,197,94,0.35); }
    .status-active.status-warning { background: #f59e0b; color: #fff; transform: scale(1.15); box-shadow: 0 0 0 3px rgba(245,158,11,0.35); }
    .status-active.status-critical { background: #ef4444; color: #fff; transform: scale(1.15); box-shadow: 0 0 0 3px rgba(239,68,68,0.35); }
    .status-active.status-ok:hover { transform: scale(1.15) translateY(-3px); box-shadow: 0 0 0 3px rgba(34,197,94,0.35), 0 12px 30px rgba(0,0,0,0.2); }
    .status-active.status-warning:hover { transform: scale(1.15) translateY(-3px); box-shadow: 0 0 0 3px rgba(245,158,11,0.35), 0 12px 30px rgba(0,0,0,0.2); }
    .status-active.status-critical:hover { transform: scale(1.15) translateY(-3px); box-shadow: 0 0 0 3px rgba(239,68,68,0.35), 0 12px 30px rgba(0,0,0,0.2); }

    .transition-hover {
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .transition-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
    }
    .fade-in-up {
        animation: fadeUp .5s ease both;
    }
    .fade-in-up-d1 { animation-delay: .05s; }
    .fade-in-up-d2 { animation-delay: .1s; }
    .fade-in-up-d3 { animation-delay: .15s; }
    .fade-in-up-d4 { animation-delay: .2s; }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header px-4 py-3 rounded-3 d-flex align-items-center gap-3" style="background: linear-gradient(135deg, var(--pi-primary-soft), rgba(45,212,191,0.06)); border-left: 4px solid var(--pi-primary); box-shadow: 0 2px 10px rgba(15,118,110,0.08);">
        <h2 class="fw-bold mb-0 fs-4" style="color: var(--pi-deep);">Gestion</h2>
    </div>
</div>

<div class="card compliance-hero shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="text-uppercase small fw-semibold text-white-50 mb-2">Estado global</div>
                <h1 class="fw-bold mb-3">Semaforo de cumplimiento institucional</h1>
                <p class="text-white-50 mb-4">
                    El panel consolida los controles clave de la plataforma y te muestra si el entorno esta listo para uso interno.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="status-pill status-ok @(overallStatus != "OK" ? "opacity-35" : "status-active")" title="OK - Todo funciona correctamente"><i class="bi bi-check-circle"></i></span>
                    <span class="status-pill status-warning @(overallStatus != "Advertencia" ? "opacity-35" : "status-active")" title="Advertencia - Hay elementos por revisar"><i class="bi bi-exclamation-circle"></i></span>
                    <span class="status-pill status-critical @(overallStatus != "Critico" ? "opacity-35" : "status-active")" title="Critico - Se requiere atencion inmediata"><i class="bi bi-x-circle"></i></span>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="bg-white bg-opacity-10 rounded-4 p-4">
                    <div class="row g-3">
                        @{
                            var summaryIndex = 0;
                        }
                        @foreach (var card in compliance.SummaryCards)
                        {
                            summaryIndex++;
                            var animClass = summaryIndex <= 4 ? $"fade-in-up-d{summaryIndex}" : "fade-in-up-d4";
                            <div class="col-6 fade-in-up @animClass">
                                <div class="rounded-4 bg-white bg-opacity-10 p-3 h-100 transition-hover">
                                    <i class="@card.IconClass fs-3 d-block mb-1"></i>
                                    <div class="small text-white-50 fw-semibold" style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.03em;">@card.Title</div>
                                    <div class="fs-3 fw-bold text-white">@card.Value</div>
                                    <div class="small text-white-50">@card.Detail</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (compliance.CurrentUserCanManageUsers)
{
    <div class="mb-4">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#adminManagementModal">
            <i class="bi bi-person-gear me-1"></i>Administrar usuarios y permisos
        </button>
    </div>
}

<div class="row g-4 mb-4">
    @{
        var checkIndex = 0;
    }
    @foreach (var check in compliance.Checks)
    {
        var checkClass = check.Status switch
        {
            "ok" => "text-bg-success",
            "critical" => "text-bg-danger",
            _ => "text-bg-warning"
        };
        var animDelay = (checkIndex % 4) + 1;
        checkIndex++;
        <div class="col-md-3 fade-in-up fade-in-up-d@(animDelay)">
            <div class="card compliance-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-2">
                        <div class="dashboard-kpi-icon bg-primary bg-opacity-10" style="width:40px;height:40px;border-radius:12px;">
                            <i class="@check.IconClass text-primary" style="font-size:1.1rem;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                <div class="fw-semibold" style="font-size:0.88rem;">@check.Title</div>
                                <span class="badge @checkClass" style="font-size:0.65rem;">@check.Status</span>
                            </div>
                            <div class="text-muted" style="font-size:0.78rem;">@check.Detail</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-md-4 fade-in-up fade-in-up-d1">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Ultimos respaldos</span>
                <a href="/dashboard#database-card" class="btn btn-sm btn-outline-primary">Ver detalle</a>
            </div>
            <div class="card-body">
                @if (compliance.RecentBackups.Count == 0)
                {
                    <div class="text-muted small">Todavia no hay respaldos en el historial.</div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var item in compliance.RecentBackups)
                        {
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <span class="badge @item.BadgeClass">@item.Badge</span>
                                </div>
                                <div class="small text-muted mt-1">@item.Detail</div>
                                <div class="small text-muted">@item.TimeLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4 fade-in-up fade-in-up-d2">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Ultimos accesos</span>
                <a href="/dashboard/activity?eventGroup=access" class="btn btn-sm btn-outline-primary">Ver detalle</a>
            </div>
            <div class="card-body">
                @if (compliance.RecentAccesses.Count == 0)
                {
                    <div class="text-muted small">Todavia no hay accesos recientes auditados.</div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var item in compliance.RecentAccesses)
                        {
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <span class="badge @item.BadgeClass">@item.Badge</span>
                                </div>
                                <div class="small text-muted mt-1">@item.Detail</div>
                                <div class="small text-muted">@item.TimeLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4 fade-in-up fade-in-up-d3">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Eventos criticos</span>
                <a href="/dashboard/activity?severity=critical" class="btn btn-sm btn-outline-primary">Ver detalle</a>
            </div>
            <div class="card-body">
                @if (compliance.CriticalEvents.Count == 0)
                {
                    <div class="text-muted small">No hay eventos criticos recientes.</div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var item in compliance.CriticalEvents)
                        {
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <span class="badge @item.BadgeClass">@item.Badge</span>
                                </div>
                                <div class="small text-muted mt-1">@item.Detail</div>
                                <div class="small text-muted">@item.TimeLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6 fade-in-up fade-in-up-d1">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Resumen de salud</div>
            <div class="card-body">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Base de datos</span><strong>@(compliance.DatabaseConnected ? "OK" : "Critico")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">HTTPS</span><strong>@(compliance.HttpsConfigured ? "Configurado" : "Advertencia")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Swagger</span><strong>@(compliance.SwaggerRestricted ? "Restringido" : "Advertencia")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">MFA Admin</span><strong>@(compliance.MfaCompliant ? "OK" : "Critico")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Backup</span><strong>@(compliance.BackupEnabled ? (compliance.BackupHealthy ? "OK" : "Advertencia") : "Deshabilitado")</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">LDAPS</span><strong>@(compliance.LdapsConfigured ? "OK" : "Advertencia")</strong></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 fade-in-up fade-in-up-d2">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Datos de sistema</div>
            <div class="card-body">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Usuarios activos</span><strong>@compliance.ActiveUsers</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Administradores</span><strong>@compliance.AdminUsers</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Fallos login 7 dias</span><strong>@compliance.FailedLoginsLast7Days</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Criticos 7 dias</span><strong>@compliance.CriticalEventsLast7Days</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">BDD</span><strong>@compliance.DatabaseFileName</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Ultima modificacion</span><strong>@(compliance.DatabaseLastWriteUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin datos")</strong></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="adminManagementModal" tabindex="-1" aria-labelledby="adminManagementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adminManagementModalLabel"><i class="bi bi-person-gear me-2"></i>Administrar usuarios y permisos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="adminUsersLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="text-muted mt-2">Cargando usuarios...</div>
                </div>
                <div id="adminUsersContent" style="display:none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#createUserPanel" aria-expanded="false" aria-controls="createUserPanel">
                            <i class="bi bi-person-plus me-1"></i>Nuevo usuario
                        </button>
                        <span id="adminUsersCount" class="text-muted small"></span>
                    </div>
                    <div id="createUserPanel" class="collapse mb-3 p-3 border rounded-3 bg-light">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted" for="createUserUsername">Usuario</label>
                                <input id="createUserUsername" type="text" class="form-control" autocomplete="off">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted" for="createUserPassword">Contrasena (min 10)</label>
                                <input id="createUserPassword" type="password" class="form-control" autocomplete="new-password">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted" for="createUserRole">Rol</label>
                                <select id="createUserRole" class="form-select">
                                    <option value="viewer">viewer</option>
                                    <option value="editor">editor</option>
                                    <option value="auditor">auditor</option>
                                    <option value="admin">admin</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <div class="form-check form-switch mt-4">
                                    <input id="createUserCanManage" class="form-check-input" type="checkbox" role="switch" disabled>
                                    <label class="form-check-label text-muted" for="createUserCanManage">Puede gestionar usuarios</label>
                                </div>
                            </div>
                            <div class="col-md-7 d-flex align-items-center justify-content-end gap-2 flex-wrap">
                                <div id="createUserError" class="alert alert-danger py-2 px-3 mb-0" style="display:none"></div>
                                <button id="createUserCancel" type="button" class="btn btn-outline-secondary btn-sm">Cancelar</button>
                                <button id="createUserSubmit" type="button" class="btn btn-success btn-sm">
                                    <i class="bi bi-person-plus me-1"></i>Crear usuario
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Rol</th>
                                    <th>Puede gestionar usuarios</th>
                                    <th>MFA</th>
                                    <th>Estado</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="adminUsersTableBody"></tbody>
                        </table>
                    </div>
                </div>
                <div id="adminUsersError" class="alert alert-danger" style="display:none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar cambio de permisos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="confirmRoleBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="confirmRoleBtn">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const adminModal = document.getElementById("adminManagementModal");
if (adminModal) {
    const loading = document.getElementById("adminUsersLoading");
    const content = document.getElementById("adminUsersContent");
    const errorDiv = document.getElementById("adminUsersError");
    const tbody = document.getElementById("adminUsersTableBody");

    const toggleCanManageVisibility = (roleSelect, canManageTd) => {
        const isAdmin = roleSelect?.value === "admin";
        const chk = canManageTd?.querySelector(".can-manage-switch");
        if (chk) {
            chk.disabled = !isAdmin;
            chk.closest(".form-check")?.classList.toggle("text-muted", !isAdmin);
            chk.closest(".form-check")?.classList.toggle("opacity-50", !isAdmin);
            if (!isAdmin) {
                chk.checked = false;
                chk.setAttribute("data-original-value", "false");
            }
        }
    };

    const updateMfaBadge = (td, state) => {
        const map = {
            enabled: ['bg-success', 'bi-shield-check', 'MFA activo con clave'],
            pending: ['bg-warning text-dark', 'bi-shield-exclamation', 'Pendiente de enrolar nueva clave'],
            disabled: ['bg-secondary', 'bi-shield-slash', 'MFA desactivado']
        };
        const [bg, icon, title] = map[state] || map.disabled;
        td.innerHTML = `<span class="badge ${bg} mfa-toggle" role="button" title="${title}"><i class="bi ${icon}"></i></span>`;
    };

    const confirmMfaAction = async (userId, username, action, actionLabel, td) => {
        if (!(await SyntroUI.confirm(`¿Esta seguro de ${actionLabel} MFA para ${username}?`))) return;

        const badge = td.querySelector(".mfa-toggle");
        badge.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
        badge.style.pointerEvents = "none";

        fetch(`/api/admin/users/${userId}/mfa`, {
            method: "PUT",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action })
        })
            .then((res) => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.json();
            })
            .then((data) => {
                updateMfaBadge(td, data.mfaState);
            })
            .catch((err) => {
                SyntroUI.alert("Error: " + err.message);
                updateMfaBadge(td, state);
            });
    };

    const createPanel = document.getElementById("createUserPanel");
    const createUsername = document.getElementById("createUserUsername");
    const createPassword = document.getElementById("createUserPassword");
    const createRole = document.getElementById("createUserRole");
    const createCanManage = document.getElementById("createUserCanManage");
    const createError = document.getElementById("createUserError");
    const createSubmit = document.getElementById("createUserSubmit");
    const createCancel = document.getElementById("createUserCancel");
    const adminUsersCount = document.getElementById("adminUsersCount");

    const setCreateError = (msg) => {
        if (!createError) return;
        createError.textContent = msg || "";
        createError.style.display = msg ? "" : "none";
    };

    const updateCreateCanManage = () => {
        if (!createCanManage) return;
        const isAdmin = createRole?.value === "admin";
        createCanManage.disabled = !isAdmin;
        createCanManage.closest(".form-check")?.classList.toggle("text-muted", !isAdmin);
        createCanManage.closest(".form-check")?.classList.toggle("opacity-50", !isAdmin);
        if (!isAdmin) createCanManage.checked = false;
    };

    if (createRole) {
        createRole.addEventListener("change", updateCreateCanManage);
    }

    const resetCreateForm = (collapse) => {
        if (createUsername) createUsername.value = "";
        if (createPassword) createPassword.value = "";
        if (createRole) createRole.value = "viewer";
        if (createCanManage) createCanManage.checked = false;
        setCreateError("");
        updateCreateCanManage();
        if (collapse && createPanel) {
            const bsCollapse = bootstrap.Collapse.getOrCreateInstance(createPanel);
            if (bsCollapse._isShown()) bsCollapse.hide();
        }
    };

    if (createCancel) {
        createCancel.addEventListener("click", () => resetCreateForm(true));
    }

    if (createSubmit) {
        createSubmit.addEventListener("click", () => {
            const username = createUsername?.value?.trim() || "";
            const password = createPassword?.value || "";
            const role = createRole?.value || "viewer";
            const canManage = (createCanManage?.checked || false) && role === "admin";
            setCreateError("");

            if (!username) {
                setCreateError("El nombre de usuario es obligatorio.");
                createUsername?.focus();
                return;
            }
            if (password.length < 10) {
                setCreateError("La contrasena debe tener al menos 10 caracteres.");
                createPassword?.focus();
                return;
            }

            createSubmit.disabled = true;
            createSubmit.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Creando...';

            fetch("/api/admin/users", {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ username, password, role, canManageUsers: canManage })
            })
                .then(async (res) => {
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);
                    return data;
                })
                .then(() => {
                    resetCreateForm(true);
                    loadUsers();
                })
                .catch((err) => {
                    setCreateError(err.message);
                })
                .finally(() => {
                    createSubmit.disabled = false;
                    createSubmit.innerHTML = '<i class="bi bi-person-plus me-1"></i>Crear usuario';
                });
        });
    }

    const loadUsers = () => {
        loading.style.display = "";
        content.style.display = "none";
        errorDiv.style.display = "none";

        fetch("/api/admin/users", { credentials: "same-origin", cache: "no-store" })
            .then((res) => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.json();
            })
            .then((users) => {
                loading.style.display = "none";
                content.style.display = "";
                if (adminUsersCount) adminUsersCount.textContent = users.length + " usuario(s)";
                    tbody.innerHTML = users.map((user) => {
                    const roleOptions = ["viewer", "editor", "auditor", "admin"].map((r) =>
                        `<option value="${r}"${user.role === r ? " selected" : ""}>${r}</option>`
                    ).join("");

                    const mfaState = user.mfaState || (user.mfaEnabled ? "enabled" : "disabled");
                    const mfaMap = { enabled: ['bg-success', 'bi-shield-check', 'MFA activo con clave'], pending: ['bg-warning text-dark', 'bi-shield-exclamation', 'Pendiente de enrolar nueva clave'], disabled: ['bg-secondary', 'bi-shield-slash', 'MFA desactivado'] };
                    const [mfaBg, mfaIcon, mfaTitle] = mfaMap[mfaState] || mfaMap.disabled;
                    const mfaHtml = `<span class="badge ${mfaBg} mfa-toggle" role="button" title="${mfaTitle}"><i class="bi ${mfaIcon}"></i></span>`;
                    const statusBadge = user.isActive
                        ? '<span class="badge bg-success">Activo</span>'
                        : '<span class="badge bg-danger">Inactivo</span>';

                    return `<tr class="${user.isActive ? "" : "opacity-50"}">
                        <td><span class="fw-semibold">${user.username}</span></td>
                        <td>
                            <select class="form-select form-select-sm role-select" data-user-id="${user.id}" data-original-role="${user.role}">
                                ${roleOptions}
                            </select>
                        </td>
                        <td class="can-manage-td">
                            <div class="form-check form-switch ${user.role !== "admin" ? "text-muted opacity-50" : ""}">
                                <input class="form-check-input can-manage-switch" type="checkbox" role="switch" data-user-id="${user.id}" data-original-value="${user.canManageUsers}" ${user.canManageUsers ? "checked" : ""} ${user.role !== "admin" ? "disabled" : ""}>
                            </div>
                        </td>
                        <td class="mfa-td">${mfaHtml}</td>
                        <td>${statusBadge}</td>
                        <td>
                            <div class="d-flex flex-column gap-1 align-items-start">
                                <button class="btn btn-sm btn-outline-primary save-user-btn" data-user-id="${user.id}" data-username="${user.username}" disabled>
                                    <i class="bi bi-floppy"></i> Guardar
                                </button>
                                <button class="btn btn-sm ${user.isActive ? "btn-outline-danger" : "btn-outline-success"} toggle-active-btn" data-user-id="${user.id}" data-username="${user.username}" data-active="${user.isActive}">
                                    <i class="bi ${user.isActive ? "bi-person-x" : "bi-person-check"}"></i> ${user.isActive ? "Dar de baja" : "Dar de alta"}
                                </button>
                            </div>
                        </td>
                    </tr>`;
                }).join("");

                tbody.querySelectorAll(".role-select").forEach((select) => {
                    select.addEventListener("change", () => {
                        const userId = select.getAttribute("data-user-id");
                        const canManageTd = tbody.querySelector(`.can-manage-td[data-user-id="${userId}"]`) || tbody.querySelector(`tr .can-manage-td`);
                        // find the correct td by traversing
                        const tr = select.closest("tr");
                        const cmTd = tr?.querySelector(".can-manage-td");
                        toggleCanManageVisibility(select, cmTd);

                        const btn = tbody.querySelector(`.save-user-btn[data-user-id="${userId}"]`);
                        if (btn) btn.disabled = false;
                    });
                });

                tbody.querySelectorAll(".can-manage-switch").forEach((el) => {
                    el.addEventListener("change", () => {
                        const userId = el.getAttribute("data-user-id");
                        const btn = tbody.querySelector(`.save-user-btn[data-user-id="${userId}"]`);
                        if (btn) btn.disabled = false;
                    });
                });

                tbody.querySelectorAll(".toggle-active-btn").forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        const userId = btn.getAttribute("data-user-id");
                        const username = btn.getAttribute("data-username");
                        const active = btn.getAttribute("data-active") === "true";
                        if (!(await SyntroUI.confirm(`¿${active ? "Dar de baja" : "Dar de alta"} al usuario ${username}?`))) return;
                        btn.disabled = true;
                        fetch(`/api/admin/users/${userId}/set-active`, {
                            method: "POST",
                            credentials: "same-origin",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ active: !active })
                        })
                            .then(async (res) => {
                                const data = await res.json().catch(() => ({}));
                                if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);
                                return data;
                            })
                            .then(() => {
                                loadUsers();
                            })
                            .catch((err) => {
                                SyntroUI.alert("Error: " + err.message);
                                btn.disabled = false;
                            });
                    });
                });

                tbody.addEventListener("click", async (ev) => {
                    const badge = ev.target.closest(".mfa-toggle");
                    if (!badge) return;

                    const tr = badge.closest("tr");
                    const mfaTd = tr?.querySelector(".mfa-td");
                    const username = tr?.querySelector("td:first-child")?.textContent?.trim() || "";
                    const userId = tr?.querySelector(".save-user-btn")?.getAttribute("data-user-id");
                    if (!userId || !mfaTd) return;

                    const isGreen = badge.classList.contains("bg-success");
                    const isOrange = badge.classList.contains("bg-warning");

                    if (isGreen) {
                        const action = await SyntroUI.prompt(
                            `MFA de ${username} esta activo con clave enrolada.\n\n` +
                            `Escriba "desactivar" para desactivar MFA.\n` +
                            `Escriba "reenrolar" para desvincular la clave y solicitar una nueva.`,
                            ""
                        );
                        if (action === "desactivar") {
                            await confirmMfaAction(userId, username, "disable", "desactivar", mfaTd);
                        } else if (action === "reenrolar") {
                            await confirmMfaAction(userId, username, "reenroll", "re-enrolar", mfaTd);
                        }
                    } else if (isOrange) {
                        const action2 = await SyntroUI.prompt(
                            `MFA de ${username} esta pendiente de enrolar clave.\n\n` +
                            `Escriba "desactivar" para desactivar MFA.\n` +
                            `Escriba "activar" para activar MFA (conserva clave pendiente).`,
                            ""
                        );
                        if (action2 === "desactivar") {
                            await confirmMfaAction(userId, username, "disable", "desactivar", mfaTd);
                        } else if (action2 === "activar") {
                            await confirmMfaAction(userId, username, "enable", "activar", mfaTd);
                        }
                    } else {
                        if (await SyntroUI.confirm(`¿Activar MFA para ${username}? Se le solicitara configurar MFA en su proximo inicio de sesion.`)) {
                            await confirmMfaAction(userId, username, "enable", "activar", mfaTd);
                        }
                    }
                });

                tbody.querySelectorAll(".save-user-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const userId = btn.getAttribute("data-user-id");
                        const username = btn.getAttribute("data-username");
                        const tr = btn.closest("tr");
                        const roleSelect = tr?.querySelector(".role-select");
                        const canManageSwitch = tr?.querySelector(".can-manage-switch");
                        const newRole = roleSelect?.value || "";
                        const newCanManage = canManageSwitch?.checked || false;
                        const origRole = roleSelect?.getAttribute("data-original-role") || "";
                        const origCanManage = canManageSwitch?.getAttribute("data-original-value") === "true";

                        if (newRole === origRole && newCanManage === origCanManage) {
                            btn.disabled = true;
                            return;
                        }

                        const confirmBody = document.getElementById("confirmRoleBody");
                        confirmBody.innerHTML = `
                            <p><strong>Usuario:</strong> ${username}</p>
                            <p><strong>Rol:</strong> ${origRole} <i class="bi bi-arrow-right mx-2"></i> ${newRole}</p>
                            <p><strong>Gestion de usuarios:</strong> ${origCanManage ? "Si" : "No"} <i class="bi bi-arrow-right mx-2"></i> ${newCanManage ? "Si" : "No"}</p>
                        `;

                        const confirmBtn = document.getElementById("confirmRoleBtn");
                        const newConfirmBtn = confirmBtn.cloneNode(true);
                        confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);

                        const modal = new bootstrap.Modal(document.getElementById("confirmRoleModal"));
                        modal.show();

                        newConfirmBtn.addEventListener("click", () => {
                            newConfirmBtn.disabled = true;
                            newConfirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Guardando...';

                            fetch(`/api/admin/users/${userId}`, {
                                method: "PUT",
                                credentials: "same-origin",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ role: newRole, canManageUsers: newCanManage })
                            })
                                .then((res) => {
                                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                                    return res.json();
                                })
                                .then(() => {
                                    modal.hide();
                                    btn.disabled = true;
                                    roleSelect?.setAttribute("data-original-role", newRole);
                                    if (canManageSwitch) canManageSwitch.setAttribute("data-original-value", newCanManage ? "true" : "false");
                                    if (newRole !== "admin" && canManageSwitch) {
                                        canManageSwitch.checked = false;
                                        canManageSwitch.setAttribute("data-original-value", "false");
                                    }
                                })
                                .catch((err) => {
                                    SyntroUI.alert("Error al guardar: " + err.message);
                                })
                                .finally(() => {
                                    newConfirmBtn.disabled = false;
                                    newConfirmBtn.innerHTML = "Guardar cambios";
                                });
                        });
                    });
                });
            })
            .catch((err) => {
                loading.style.display = "none";
                errorDiv.style.display = "";
                errorDiv.textContent = "Error al cargar usuarios: " + err.message;
            });
    };

    adminModal.addEventListener("show.bs.modal", loadUsers);
}
</script>
}
