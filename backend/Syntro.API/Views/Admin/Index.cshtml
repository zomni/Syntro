@section Scripts {
    <script>
        (() => {
            const packageFileInput = document.getElementById("projectPackageFileInput");
            const packageUploadButton = document.getElementById("projectPackageUploadButton");
            const packageUploadForm = document.getElementById("projectPackageUploadForm");

            if (!packageFileInput || !packageUploadButton || !packageUploadForm) {
                return;
            }

            let hasPendingProjectPackageFile = false;

            const updateUploadState = () => {
                hasPendingProjectPackageFile = Boolean(packageFileInput.files && packageFileInput.files.length > 0);
                packageUploadButton.disabled = !hasPendingProjectPackageFile;
                packageUploadButton.classList.toggle("btn-secondary", !hasPendingProjectPackageFile);
                packageUploadButton.classList.toggle("btn-dark", hasPendingProjectPackageFile);
            };

            const confirmPendingNavigation = () => {
                if (!hasPendingProjectPackageFile) {
                    return true;
                }
                return window.confirm("Tienes un paquete completo pendiente por subir. \u00bfDeseas continuar sin subirlo?");
            };

            packageFileInput.addEventListener("change", updateUploadState);

            let packageUploadAbort = null;

            packageUploadForm.addEventListener("submit", (event) => {
                event.preventDefault();
                if (!packageFileInput.files || packageFileInput.files.length === 0) return;

                hasPendingProjectPackageFile = false;
                packageUploadButton.disabled = true;

                var overlay = document.getElementById("projectPackageLoadingOverlay");
                var progressBar = document.getElementById("packageProgressBar");
                var percentLabel = document.getElementById("packageOverlayPercent");
                var titleEl = document.getElementById("packageOverlayTitle");
                var subtitleEl = document.getElementById("packageOverlaySubtitle");
                var cancelBtn = document.getElementById("packageCancelButton");

                if (overlay) {
                    if (overlay.parentElement !== document.body) {
                        document.body.appendChild(overlay);
                    }
                    overlay.classList.remove("d-none");
                }
                if (progressBar) { progressBar.style.width = "0%"; progressBar.classList.remove("bg-danger"); }
                if (percentLabel) percentLabel.textContent = "0%";
                if (titleEl) titleEl.textContent = "Restaurando paquete completo";
                if (subtitleEl) subtitleEl.textContent = "Subiendo archivo...";

                var formData = new FormData(packageUploadForm);
                var xhr = new XMLHttpRequest();
                packageUploadAbort = () => { xhr.abort(); };

                cancelBtn.onclick = () => { xhr.abort(); };

                xhr.upload.addEventListener("progress", (e) => {
                    if (e.lengthComputable) {
                        var pct = Math.round((e.loaded / e.total) * 100);
                        if (progressBar) progressBar.style.width = pct + "%";
                        if (percentLabel) {
                            var loadedMB = (e.loaded / 1048576).toFixed(1);
                            var totalMB = (e.total / 1048576).toFixed(1);
                            percentLabel.textContent = pct + "% \u2014 " + loadedMB + " MB / " + totalMB + " MB";
                        }
                    }
                });

                xhr.addEventListener("load", () => {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        var resp;
                        try { resp = JSON.parse(xhr.responseText); } catch { resp = null; }
                        if (titleEl) titleEl.textContent = "\u2705 Paquete restaurado correctamente";
                        if (subtitleEl) subtitleEl.textContent = resp?.message || "Recarga la pagina para ver los cambios.";
                        if (progressBar) { progressBar.style.width = "100%"; progressBar.classList.remove("bg-danger"); progressBar.classList.add("bg-success"); }
                        if (percentLabel) percentLabel.textContent = "100%";
                        if (cancelBtn) cancelBtn.style.display = "none";
                        hasPendingProjectPackageFile = false;
                        setTimeout(function () { window.location.reload(); }, 2500);
                    } else {
                        var errMsg;
                        try { var errResp = JSON.parse(xhr.responseText); errMsg = errResp?.message; } catch { errMsg = null; }
                        if (titleEl) titleEl.textContent = "\u274c Error al restaurar paquete";
                        if (subtitleEl) subtitleEl.textContent = errMsg || ("Error del servidor (" + xhr.status + ")");
                        if (progressBar) progressBar.classList.add("bg-danger");
                        if (percentLabel) percentLabel.textContent = "";
                        if (cancelBtn) { cancelBtn.textContent = "Cerrar"; cancelBtn.onclick = () => { overlay?.classList.add("d-none"); cancelBtn.style.display = ""; cancelBtn.textContent = '\u2390 Cancelar'; }; }
                        packageUploadButton.disabled = false;
                    }
                    packageUploadAbort = null;
                });

                xhr.addEventListener("error", () => {
                    if (titleEl) titleEl.textContent = "\u274c Error de conexion";
                    if (subtitleEl) subtitleEl.textContent = "No se pudo conectar con el servidor. Verifica tu conexion.";
                    if (progressBar) progressBar.classList.add("bg-danger");
                    if (percentLabel) percentLabel.textContent = "";
                    if (cancelBtn) { cancelBtn.textContent = "Cerrar"; cancelBtn.onclick = () => { overlay?.classList.add("d-none"); cancelBtn.style.display = ""; cancelBtn.textContent = '\u2390 Cancelar'; }; }
                    packageUploadButton.disabled = false;
                    packageUploadAbort = null;
                });

                xhr.addEventListener("abort", () => {
                    if (titleEl) titleEl.textContent = "Carga cancelada";
                    if (subtitleEl) subtitleEl.textContent = "La restauracion fue interrumpida por el usuario.";
                    if (progressBar) progressBar.classList.add("bg-danger");
                    if (percentLabel) percentLabel.textContent = "";
                    if (cancelBtn) { cancelBtn.textContent = "Cerrar"; cancelBtn.onclick = () => { overlay?.classList.add("d-none"); cancelBtn.style.display = ""; cancelBtn.textContent = '\u2390 Cancelar'; }; }
                    packageUploadButton.disabled = false;
                    packageUploadAbort = null;
                });

                xhr.open("POST", packageUploadForm.action);
                xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
                xhr.send(formData);
            });

            const packageDownloadButton = document.getElementById("projectPackageDownloadButton");
            if (packageDownloadButton) {
                packageDownloadButton.addEventListener("click", function () {
                    var btn = this;
                    btn.dataset.origHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Generando paquete...';
                    btn.classList.add("disabled");
                    btn.setAttribute("aria-disabled", "true");
                    setTimeout(function () {
                        btn.innerHTML = btn.dataset.origHtml;
                        btn.classList.remove("disabled");
                        btn.removeAttribute("aria-disabled");
                    }, 30000);
                });
            }

            document.addEventListener("click", (event) => {
                const anchor = event.target.closest("a[href]");
                if (!anchor) {
                    return;
                }

                const href = anchor.getAttribute("href");
                if (!href || href.startsWith("#") || href.startsWith("javascript:")) {
                    return;
                }

                const destination = new URL(anchor.href, window.location.href);
                const current = new URL(window.location.href);

                if (destination.href === current.href) {
                    return;
                }

                if (!confirmPendingNavigation()) {
                    event.preventDefault();
                    event.stopPropagation();
                    return;
                }

                hasPendingProjectPackageFile = false;
            }, true);

            document.addEventListener("submit", (event) => {
                const form = event.target;
                if (!(form instanceof HTMLFormElement) || form === packageUploadForm) {
                    return;
                }

                if (!confirmPendingNavigation()) {
                    event.preventDefault();
                    event.stopPropagation();
                    return;
                }

                hasPendingProjectPackageFile = false;
            }, true);

            window.addEventListener("beforeunload", (event) => {
                if (!hasPendingProjectPackageFile) {
                    return;
                }

                event.preventDefault();
                event.returnValue = "";
            });

            document.querySelectorAll(".js-map-link").forEach((link) => {
                link.addEventListener("click", (event) => {
                    event.preventDefault();

                    if (!confirmPendingNavigation()) {
                        return;
                    }

                    hasPendingProjectPackageFile = false;
                    window.open(link.href, "syntro-map");
                });
            });

            updateUploadState();
        })();

        let backupsExpanded = false;
        let backupsPageIndex = 0;
        const BACKUPS_PER_PAGE = 10;
        function toggleBackups() {
            var btn = document.getElementById("backups-toggle-btn");
            var rows = document.querySelectorAll(".backup-row");
            var pagination = document.getElementById("backups-pagination");
            if (!btn || !rows.length) return;
            backupsExpanded = !backupsExpanded;
            if (backupsExpanded) {
                backupsPageIndex = 0;
                renderBackupsPage();
                if (pagination) pagination.style.display = "flex";
                btn.innerHTML = '<i class="bi bi-chevron-up me-1"></i>Mostrar menos';
            } else {
                rows.forEach(function(row, i) { row.style.display = i < 3 ? "" : "none"; });
                if (pagination) pagination.style.display = "none";
                btn.innerHTML = '<i class="bi bi-chevron-down me-1"></i>Ver todos (<span id="backups-total-count">' + rows.length + '</span>)';
            }
        }
        function backupsPage(dir) {
            var rows = document.querySelectorAll(".backup-row");
            var totalPages = Math.ceil(rows.length / BACKUPS_PER_PAGE);
            backupsPageIndex = Math.max(0, Math.min(totalPages - 1, backupsPageIndex + dir));
            renderBackupsPage();
        }
        function renderBackupsPage() {
            var rows = document.querySelectorAll(".backup-row");
            var totalPages = Math.ceil(rows.length / BACKUPS_PER_PAGE);
            var start = backupsPageIndex * BACKUPS_PER_PAGE;
            var end = start + BACKUPS_PER_PAGE;
            rows.forEach(function(row, i) { row.style.display = (i >= start && i < end) ? "" : "none"; });
            var info = document.getElementById("backups-page-info");
            var prevBtn = document.getElementById("backups-prev-btn");
            var nextBtn = document.getElementById("backups-next-btn");
            if (info) info.textContent = "Pagina " + (backupsPageIndex + 1) + " de " + totalPages;
            if (prevBtn) prevBtn.disabled = backupsPageIndex === 0;
            if (nextBtn) nextBtn.disabled = backupsPageIndex >= totalPages - 1;
        }
    </script>
    @if (isAdmin)
    {
    <script>
        const mlStatusBadge = document.getElementById("ml-status-badge");
        const mlClassStatus = document.getElementById("ml-class-status");
        const mlClassFile = document.getElementById("ml-class-file");
        const mlClassSize = document.getElementById("ml-class-size");
        const mlClassDate = document.getElementById("ml-class-date");
        const mlRiskStatus = document.getElementById("ml-risk-status");
        const mlRiskFile = document.getElementById("ml-risk-file");
        const mlRiskSize = document.getElementById("ml-risk-size");
        const mlRiskDate = document.getElementById("ml-risk-date");
        const mlWeightsRow = document.getElementById("ml-weights-row");
        const mlMlWeight = document.getElementById("ml-ml-weight");
        const mlRuleWeight = document.getElementById("ml-rule-weight");
        const mlItemsCount = document.getElementById("ml-items-count");
        const mlObsCount = document.getElementById("ml-obs-count");
        const mlClassMetrics = document.getElementById("ml-class-metrics");
        const mlClassAccuracy = document.getElementById("ml-class-accuracy");
        const mlClassF1 = document.getElementById("ml-class-f1");
        const mlRiskMetrics = document.getElementById("ml-risk-metrics");
        const mlRiskAccuracy = document.getElementById("ml-risk-accuracy");
        const mlRiskF1 = document.getElementById("ml-risk-f1");
        const mlUsageStats = document.getElementById("ml-usage-stats");
        const mlClassifiedItems = document.getElementById("ml-classified-items");
        const mlScoredDevices = document.getElementById("ml-scored-devices");
        const mlLastTraining = document.getElementById("ml-last-training");
        const mlLastTrainDate = document.getElementById("ml-last-train-date");
        const mlLastTrainAccuracy = document.getElementById("ml-last-train-accuracy");
        const mlLastTrainF1 = document.getElementById("ml-last-train-f1");
        const mlLastTrainAccStd = document.getElementById("ml-last-train-acc-std");
        const mlLastTrainF1Std = document.getElementById("ml-last-train-f1-std");

        function mlFormatBytes(b) {
            if (!b) return "--";
            if (b < 1024) return b + " B";
            if (b < 1048576) return (b / 1024).toFixed(1) + " KB";
            return (b / 1048576).toFixed(2) + " MB";
        }

        function mlFormatDate(utc) {
            if (!utc) return "--";
            var d = new Date(utc);
            return d.toLocaleDateString("es-CL") + " " + d.toLocaleTimeString("es-CL", { hour: "2-digit", minute: "2-digit" });
        }

        function mlRenderStatus(s) {
            mlStatusBadge.textContent = s.enabled ? "Activo" : "Inactivo";
            mlStatusBadge.className = "badge " + (s.enabled ? "bg-success" : "bg-secondary");

            var ic = s.itemClassification;
            mlClassStatus.textContent = ic.loaded ? "Cargado" : ic.fileExists ? "Disponible" : "Sin modelo";
            mlClassStatus.className = "badge " + (ic.loaded ? "bg-success" : ic.fileExists ? "bg-info" : "bg-secondary");
            mlClassFile.textContent = ic.fileExists ? "item-classification.zip" : "--";
            mlClassSize.textContent = mlFormatBytes(ic.fileSizeBytes);
            mlClassDate.textContent = mlFormatDate(ic.lastModifiedUtc);

            var rp = s.riskPrediction;
            mlRiskStatus.textContent = rp.loaded ? "Cargado" : rp.fileExists ? "Disponible" : "Sin modelo";
            mlRiskStatus.className = "badge " + (rp.loaded ? "bg-success" : rp.fileExists ? "bg-info" : "bg-secondary");
            mlRiskFile.textContent = rp.fileExists ? "risk-prediction.zip" : "--";
            mlRiskSize.textContent = mlFormatBytes(rp.fileSizeBytes);
            mlRiskDate.textContent = mlFormatDate(rp.lastModifiedUtc);

            if (rp.mlWeight !== undefined && rp.ruleWeight !== undefined) {
                mlWeightsRow.style.display = "";
                mlMlWeight.textContent = (rp.mlWeight * 100).toFixed(0) + "%";
                mlRuleWeight.textContent = (rp.ruleWeight * 100).toFixed(0) + "%";
            }

            var td = s.trainingData;
            mlItemsCount.textContent = td.importedItemsCount;
            mlObsCount.textContent = td.telemetryObservationsCount;

            if (td.mlClassifiedItems !== undefined) {
                mlUsageStats.style.display = "";
                mlClassifiedItems.textContent = td.mlClassifiedItems;
                mlScoredDevices.textContent = td.mlScoredDevices;
            }

            var lastClass = ic.lastTraining;
            var lastRisk = rp.lastTraining;
            var lastTrain = lastClass || lastRisk;
            if (lastTrain && lastTrain.createdAtUtc) {
                mlLastTraining.style.display = "";
                mlLastTrainDate.textContent = mlFormatDate(lastTrain.createdAtUtc);
                mlLastTrainAccuracy.textContent = (lastTrain.accuracy * 100).toFixed(1) + "%";
                mlLastTrainF1.textContent = (lastTrain.f1Score * 100).toFixed(1) + "%";
                var accStd = lastTrain.accuracyStdDev || lastTrain.accuracyStd || 0;
                var f1Std = lastTrain.f1ScoreStdDev || lastTrain.f1ScoreStd || 0;
                mlLastTrainAccStd.textContent = accStd > 0 ? " \u00B1 " + (accStd * 100).toFixed(1) + "%" : "";
                mlLastTrainF1Std.textContent = f1Std > 0 ? " \u00B1 " + (f1Std * 100).toFixed(1) + "%" : "";
            }
        }

        async function mlFetchStatus() {
            try {
                var r = await fetch("/api/ml/status");
                if (!r.ok) return;
                mlRenderStatus(await r.json());
            } catch (e) { console.error("ML status error:", e); }
        }

        mlFetchStatus();
    </script>
    }
}

