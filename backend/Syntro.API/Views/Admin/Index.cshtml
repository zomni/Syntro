@model Syntro.API.ViewModels.AdminDashboardViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole(Syntro.API.Models.AppRoles.Admin);
    var totalItems = Math.Max(Model.TotalImportedItems, 1);
    var assignedPercent = Math.Round(Model.AssignedItems * 100.0 / totalItems, 1);
    var pendingPercent = Math.Round(Model.PendingAssignmentItems * 100.0 / totalItems, 1);
    var suggestedPercent = Math.Round(Model.SuggestedItems * 100.0 / totalItems, 1);
    var assignedAngle = Math.Clamp(Model.AssignedItems * 360.0 / totalItems, 0, 360);
    var suggestedAngle = Math.Clamp((Model.AssignedItems + Model.SuggestedItems) * 360.0 / totalItems, 0, 360);
    var maxCategoryCount = Math.Max(Model.CategoryBreakdown.Any() ? Model.CategoryBreakdown.Max(category => category.Count) : 0, 1);
    var displayTimeZone = Syntro.API.Services.TelemetryTimeSettings.ResolveTimeZone(Config);

    string FormatChileDateTime(DateTime? value, string format = "dd/MM/yyyy HH:mm")
    {
        if (!value.HasValue)
        {
            return "Sin datos";
        }

        var utcValue = value.Value.Kind == DateTimeKind.Utc
            ? value.Value
            : DateTime.SpecifyKind(value.Value, DateTimeKind.Utc);

        return TimeZoneInfo.ConvertTimeFromUtc(utcValue, displayTimeZone).ToString(format);
    }

    string TranslateCategory(string? category)
    {
        var raw = (category ?? string.Empty).Trim();
        var translated = raw.ToLowerInvariant() switch
        {
            "pc" => "Pc",
            "printer" => "Impresora",
            "other" => "Otro",
            _ => raw
        };

        if (string.IsNullOrWhiteSpace(translated))
        {
            return translated;
        }

        return char.ToUpperInvariant(translated[0]) + translated.Substring(1);
    }
}

<style>
    .dashboard-hero {
        border: 0;
        border-radius: 22px;
        background:
            radial-gradient(circle at top right, rgba(56, 189, 248, 0.22), transparent 34%),
            linear-gradient(135deg, #0f172a 0%, #1e3a5f 48%, #2d79a0 100%);
        color: #fff;
        overflow: hidden;
    }

    .dashboard-hero .text-muted { color: rgba(255, 255, 255, 0.72) !important; }
    .transition-hover {
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .transition-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
    }
    .dashboard-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .dashboard-card .card-header {
        border-bottom: 1px solid rgba(226, 232, 240, 0.7);
        padding: 1rem 1.25rem;
        position: relative;
    }
    .dashboard-card .card-header::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: 0 4px 4px 0;
        background: linear-gradient(180deg, #2d79a0, #38bdf8);
    }
    .dashboard-kpi-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .dashboard-card:hover .dashboard-kpi-icon {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }
    .assignment-donut {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: conic-gradient(#0ea5e9 0deg @(assignedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg, #f59e0b @(assignedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg @(suggestedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg, #e2e8f0 @(suggestedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg 360deg);
        display: grid;
        place-items: center;
        margin: 0 auto;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08);
        transition: transform .4s ease;
    }
    .dashboard-card:hover .assignment-donut {
        transform: scale(1.03);
    }
    .assignment-donut::after {
        content: "@assignedPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%";
        width: 118px;
        height: 118px;
        border-radius: 50%;
        background: #fff;
        display: grid;
        place-items: center;
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 800;
    }
    .chart-legend-dot { width: 10px; height: 10px; border-radius: 999px; display: inline-block; }
    .category-bar-track { height: 10px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
    .category-bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2d79a0, #38bdf8); }
    .activity-dot { width: 11px; height: 11px; border-radius: 999px; background: #2d79a0; box-shadow: 0 0 0 4px rgba(45, 121, 160, 0.12); }

    .risk-gauge {
        width: 100%;
        height: 10px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
        position: relative;
    }
    .risk-gauge-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #22c55e, #f59e0b, #ef4444);
        transition: width .6s ease;
    }
    .risk-pulse {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        animation: pulse-dot 2s ease infinite;
    }
    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: .5; transform: scale(1.4); }
    }

    .fade-in-up {
        animation: fadeUp .5s ease both;
    }
    .fade-in-up-d1 { animation-delay: .05s; }
    .fade-in-up-d2 { animation-delay: .1s; }
    .fade-in-up-d3 { animation-delay: .15s; }
    .fade-in-up-d4 { animation-delay: .2s; }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="page-header px-4 py-3 rounded-3" style="background: linear-gradient(135deg, var(--pi-primary-soft), rgba(45,212,191,0.06)); border-left: 4px solid var(--pi-primary); box-shadow: 0 2px 10px rgba(15,118,110,0.08);">
        <h2 class="fw-bold mb-0 fs-4" style="color: var(--pi-deep);">Dashboard</h2>
    </div>

</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card dashboard-hero shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="text-uppercase small fw-semibold text-muted mb-2">Vista general</div>
                <h1 class="fw-bold mb-3">Estado del inventario y mapa</h1>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/dashboard/inventory" class="btn btn-light fw-semibold">
                        <i class="bi bi-list-ul me-1"></i> Revisar inventario
                    </a>
                    <a href="/dashboard/locations" class="btn btn-outline-light fw-semibold">
                        <i class="bi bi-buildings me-1"></i> Ver edificios
                    </a>
                    <a href="@Model.FrontendMapUrl" class="btn btn-outline-light fw-semibold js-map-link" target="syntro-map">
                        <i class="bi bi-map me-1"></i> Abrir mapa
                    </a>
                </div>
            </div>
            <div class="col-lg-5 fade-in-up fade-in-up-d1">
                <div class="bg-white bg-opacity-10 rounded-4 p-4 transition-hover">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-white-50 small fw-semibold">Progreso de asignacion</span>
                        <span class="badge bg-info bg-opacity-75 fs-6 fw-bold px-3 py-1">@assignedPercent.ToString("F1")%</span>
                    </div>
                    <div class="progress bg-white bg-opacity-25" style="height: 14px;">
                        <div class="progress-bar bg-info" style="width: @assignedPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <div class="row g-3 mt-3">
                        <div class="col-4">
                            <div class="rounded-3 bg-white bg-opacity-10 p-2 text-center">
                                <div class="fs-4 fw-bold text-white">@Model.TotalImportedItems</div>
                                <div class="small text-white-50">Total</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="rounded-3 bg-white bg-opacity-10 p-2 text-center">
                                <div class="fs-4 fw-bold text-white">@Model.AssignedItems</div>
                                <div class="small text-white-50">Asignados</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="rounded-3 bg-white bg-opacity-10 p-2 text-center">
                                <div class="fs-4 fw-bold text-warning">@Model.PendingAssignmentItems</div>
                                <div class="small text-white-50">Pendientes</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 fade-in-up fade-in-up-d1">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-primary bg-opacity-10">
                        <i class="bi bi-buildings text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Edificios sincronizados</div>
                        <div class="fs-3 fw-bold">@Model.SyncedBuildings</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d2">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-success bg-opacity-10">
                        <i class="bi bi-pc-display text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Equipos importados</div>
                        <div class="fs-3 fw-bold">@Model.TotalImportedItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d3">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-info bg-opacity-10">
                        <i class="bi bi-check2-circle text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Asignados manualmente</div>
                        <div class="fs-3 fw-bold">@Model.AssignedItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d4">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-warning bg-opacity-10">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pendientes</div>
                        <div class="fs-3 fw-bold">@Model.PendingAssignmentItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5 fade-in-up fade-in-up-d1">
        <div class="card dashboard-card h-100">
            <div class="card-header bg-white fw-semibold">Asignacion de equipos</div>
            <div class="card-body">
                <div class="assignment-donut mb-3"></div>
                <div class="d-grid gap-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="chart-legend-dot bg-info me-2"></span>Asignados</span>
                        <strong>@Model.AssignedItems (@assignedPercent.ToString("F1")%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="chart-legend-dot bg-warning me-2"></span>Con sugerencia</span>
                        <strong>@Model.SuggestedItems (@suggestedPercent.ToString("F1")%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="chart-legend-dot bg-secondary me-2"></span>Pendientes</span>
                        <strong>@Model.PendingAssignmentItems (@pendingPercent.ToString("F1")%)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 fade-in-up fade-in-up-d2">
        <div class="card dashboard-card h-100">
            <div class="card-header bg-white fw-semibold">Categorias principales</div>
            <div class="card-body">
                @if (Model.CategoryBreakdown.Count == 0)
                {
                    <div class="text-muted">Todavia no hay equipos importados.</div>
                }
                else
                {
                    @foreach (var category in Model.CategoryBreakdown)
                    {
                        var width = Math.Round(category.Count * 100.0 / maxCategoryCount, 1);
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@TranslateCategory(category.Category)</span>
                                <span class="text-muted">@category.Count</span>
                            </div>
                            <div class="category-bar-track">
                                <div class="category-bar-fill" style="width: @width.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3 fade-in-up fade-in-up-d3">
        <div class="card dashboard-card h-100">
            <div class="card-header bg-white fw-semibold">Pulso operativo</div>
            <div class="card-body d-grid gap-3">
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Salas</span>
                    <strong>@Model.SyncedRooms</strong>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Categorias</span>
                    <strong>@Model.DistinctImportedCategories</strong>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Robados</span>
                    <strong>@Model.StolenItems</strong>
                </div>
                <div>
                    <div class="small text-muted mb-1">BDD actualizada</div>
                    <div class="fw-semibold">@FormatChileDateTime(Model.DatabaseLastWriteUtc)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card dashboard-card">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-diagram-3 me-2"></i>Red y riesgo</span>
                <a href="/dashboard/network-telemetry" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-arrow-right me-1"></i> Ver detalle
                </a>
            </div>
            <div class="card-body">
                @if (Model.HasNetworkTelemetryData)
                {
                    var riskTone = Model.LatestNetworkRiskLevel switch
                    {
                        "critical" => "danger",
                        "high" => "danger",
                        "medium" => "warning",
                        "low" => "success",
                        _ => "secondary"
                    };
                    var riskLabel = Model.LatestNetworkRiskLevel switch
                    {
                        "critical" => "Critico",
                        "high" => "Alto",
                        "medium" => "Medio",
                        "low" => "Bajo",
                        _ => "Sin datos"
                    };
                    var gaugeFill = Math.Clamp(Model.LatestNetworkRiskScore, 0, 100);
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <div class="risk-pulse bg-@riskTone"></div>
                                <div>
                                    <div class="text-muted small">Nivel de riesgo</div>
                                    <div class="fs-4 fw-bold text-@riskTone">@riskLabel</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Puntaje de riesgo</span>
                                    <span class="fw-semibold">@Model.LatestNetworkRiskScore/100</span>
                                </div>
                                <div class="risk-gauge">
                                    <div class="risk-gauge-fill" style="width: @gaugeFill%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-danger bg-opacity-10">
                                    <i class="bi bi-shield-exclamation text-danger fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Dispositivos de alto riesgo</div>
                                    <div class="fs-4 fw-bold">@Model.LatestNetworkHighRiskCount</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-info bg-opacity-10">
                                    <i class="bi bi-laptop text-info fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Dispositivos detectados</div>
                                    <div class="fs-4 fw-bold">@Model.LatestNetworkDeviceCount</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-secondary bg-opacity-10">
                                    <i class="bi bi-clock text-secondary fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Ultimo escaneo</div>
                                    <div class="fw-semibold small">@FormatChileDateTime(Model.LatestNetworkScanUtc, "dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-secondary bg-opacity-10">
                                    <i class="bi bi-diagram-3 text-secondary fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Monitoreo de red y riesgo</div>
                                    <div class="text-muted small mt-1">Escanea tu red para detectar dispositivos conectados, evaluar su nivel de riesgo y mantener un historial de telemetria. Programa escaneos periodicos para mantenerte al dia.</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/dashboard/network-telemetry" class="btn btn-primary">
                                <i class="bi bi-arrow-right me-1"></i> Ir a Red y riesgo
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (isAdmin)
{
    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card dashboard-card" id="database-card">
                <div class="card-header bg-white fw-semibold">Base de datos</div>
                <div class="card-body">
                    <div class="row g-4 align-items-start">
                        <div class="col-lg-5">
                            <div class="fw-semibold mb-1">Paquete completo</div>
                            <div class="form-text mb-3">Descarga el paquete con todos los datos y restaura la aplicacion completa con un solo archivo.</div>
                            <div class="d-grid gap-2">
                                <a href="/dashboard/project-package/download" class="btn btn-outline-dark" id="projectPackageDownloadButton">
                                    <i class="bi bi-box-seam me-1"></i> Descargar paquete completo
                                </a>
                            </div>
                            <div class="form-text mt-2">El paquete completo incluye DB, formularios PDF, documentos de equipos, claves locales de sesion/MFA y respaldos offline del frontend.</div>
                        </div>
                        <div class="col-lg-7">
                            <div class="small text-muted mb-2">Restaurar paquete completo</div>
                            <form id="projectPackageUploadForm" method="post" action="/dashboard/project-package/upload" enctype="multipart/form-data" class="row g-3">
                                @Html.AntiForgeryToken()
                                <div class="col-md-8">
                                    <input id="projectPackageFileInput" type="file" name="packageFile" class="form-control" accept=".zip" required />
                                    <div class="form-text">Restaura DB, formularios PDF, claves locales y los respaldos offline del frontend.</div>
                                </div>
                                <div class="col-md-4 d-grid">
                                    <button id="projectPackageUploadButton" type="submit" class="btn btn-secondary" disabled>
                                        <i class="bi bi-box-arrow-in-up me-1"></i> Subir paquete
                                    </button>
                                </div>
                            </form>

                            <div id="projectPackageLoadingOverlay" class="d-none"
                                 style="position:fixed; top:0; left:0; right:0; bottom:0; z-index:99999;
                                        background:rgba(0,0,0,0.75); display:flex; align-items:center;
                                        justify-content:center; cursor:default;">
                                <div class="text-center text-white p-4" style="max-width:420px; width:100%;">
                                    <div class="spinner-border spinner-border-lg mb-3" role="status" style="width:3.5rem; height:3.5rem;"></div>
                                    <div class="fw-semibold mb-1" id="packageOverlayTitle">Restaurando paquete completo</div>
                                    <div class="small text-white-50 mb-3" id="packageOverlaySubtitle">Este proceso puede tardar varios minutos. No cierres la pesta&ntilde;a ni navegues a otra p&aacute;gina.</div>
                                    <div class="progress mb-3" style="height:8px; background:rgba(255,255,255,0.15);">
                                        <div id="packageProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width:0%;"></div>
                                    </div>
                                    <div class="small text-white-50 mb-3" id="packageOverlayPercent">0%</div>
                                    <button id="packageCancelButton" type="button" class="btn btn-outline-light btn-sm" style="min-width:140px;">
                                        <i class="bi bi-x-circle me-1"></i> Cancelar
                                    </button>
                                </div>
                            </div>

                            <div class="mt-4">
                                <div class="small text-muted mb-2">Respaldos disponibles</div>
                                @if (Model.DatabaseBackups.Count == 0)
                                {
                                    <div class="text-muted small">Todavia no hay respaldos guardados.</div>
                                }
                                else
                                {
                                    var allBackups = Model.DatabaseBackups.ToList();
                                    var hasMoreBackups = allBackups.Count > 3;
                                    <div class="d-flex gap-3 align-items-start">
                                        <div class="table-responsive flex-grow-1">
                                            <table class="table table-sm align-middle mb-0" id="backups-table">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Archivo</th>
                                                        <th>Fecha</th>
                                                        <th>Tamano</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="backups-tbody">
                                                    @for (var i = 0; i < allBackups.Count; i++)
                                                    {
                                                        var backup = allBackups[i];
                                                        var hidden = i >= 3 ? "style=\"display:none\"" : "";
                                                        <tr class="backup-row" @Html.Raw(hidden) data-index="@i">
                                                            <td class="small fw-semibold">@backup.FileName</td>
                                                            <td class="small">@backup.LastWriteUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                            <td class="small">@($"{backup.SizeBytes / 1024.0 / 1024.0:F2} MB")</td>
                                                            <td class="text-end">
                                                                <div class="d-flex gap-2 justify-content-end">
                                                                    <a href="/dashboard/database/backups/@backup.FileName" class="btn btn-sm btn-outline-secondary">
                                                                        Descargar
                                                                    </a>
                                                                    <form method="post" action="/admin/database/backups/@backup.FileName/restore" onsubmit="return confirm('Se restaurara este respaldo y se reemplazara la base actual. Â¿Continuar?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                                                            Restaurar
                                                                        </button>
                                                                    </form>
                                                                    <form method="post" action="/admin/database/backups/@backup.FileName/delete" onsubmit="return confirm('Se eliminara este respaldo. Esta accion no se puede deshacer. Â¿Continuar?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                            Eliminar
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        @if (hasMoreBackups)
                                        {
                                            <div class="d-flex flex-column align-items-center gap-2" style="flex-shrink:0;">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" id="backups-toggle-btn" onclick="toggleBackups()">
                                                    <i class="bi bi-chevron-down me-1"></i>Ver todos (<span id="backups-total-count">@allBackups.Count</span>)
                                                </button>
                                                <div id="backups-pagination" class="d-flex align-items-center gap-1" style="display:none !important">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="backups-prev-btn" onclick="backupsPage(-1)" disabled>
                                                        <i class="bi bi-chevron-left"></i>
                                                    </button>
                                                    <span class="small text-muted" id="backups-page-info"></span>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="backups-next-btn" onclick="backupsPage(1)">
                                                        <i class="bi bi-chevron-right"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

