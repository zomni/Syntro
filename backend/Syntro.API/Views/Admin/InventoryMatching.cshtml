@using System.Text.Json
@using System.Text.Json.Serialization
@{
    ViewData["Title"] = "Coincidencias inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var telemetryJsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
}

<style>
    .telemetry-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .telemetry-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .telemetry-card .card-header {
        border-bottom: 1px solid rgba(226, 232, 240, 0.7);
        padding: 1rem 1.25rem;
        position: relative;
    }
    .telemetry-card .card-header::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: 0 4px 4px 0;
        background: linear-gradient(180deg, #2d79a0, #38bdf8);
    }
    .telemetry-kpi {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .telemetry-card:hover .telemetry-kpi {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }
    .telemetry-table-wrap {
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 16px;
        overflow: hidden;
    }
    .telemetry-table-wrap table {
        margin-bottom: 0;
    }
    .telemetry-table-wrap thead th {
        background: #f8fafc;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        vertical-align: middle;
        white-space: nowrap;
    }
    .telemetry-table-wrap tbody tr:hover {
        background: rgba(14, 165, 233, 0.05);
    }
    .telemetry-sort-button {
        border: 0;
        background: transparent;
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        white-space: nowrap;
    }
    .telemetry-sort-button i {
        font-size: 0.75rem;
        color: #94a3b8;
    }
    .telemetry-sort-button.is-active i {
        color: #003366;
    }
    .telemetry-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .telemetry-pill-critical { background: #fee2e2; color: #b91c1c; }
    .telemetry-pill-high { background: #ffedd5; color: #c2410c; }
    .telemetry-pill-medium { background: #fef3c7; color: #a16207; }
    .telemetry-pill-low { background: #dcfce7; color: #15803d; }
    .telemetry-pill-unknown { background: #e2e8f0; color: #475569; }
    .telemetry-pill-matched { background: #dcfce7; color: #15803d; }
    .telemetry-pill-unmatched { background: #fee2e2; color: #b91c1c; }
    .match-chip {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: #f8fafc;
        color: #475569;
        cursor: pointer;
        user-select: none;
        transition: background .2s ease, color .2s ease, border-color .2s ease;
    }
    .match-chip.is-active {
        background: #003366;
        border-color: #003366;
        color: #ffffff;
    }
    .telemetry-loading-shell {
        min-height: 320px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 16px;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
    }
    .telemetry-loading-content {
        display: grid;
        gap: 10px;
        justify-items: center;
        text-align: center;
        color: #64748b;
    }
</style>

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div class="page-header px-4 py-3 rounded-3" style="background: linear-gradient(135deg, var(--pi-primary-soft), rgba(45,212,191,0.06)); border-left: 4px solid var(--pi-primary); box-shadow: 0 2px 10px rgba(15,118,110,0.08);">
        <h2 class="fw-bold mb-0 fs-4" style="color: var(--pi-deep);">Coincidencias inventario</h2>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <select id="matching-snapshot-select" class="form-select form-select-sm" style="min-width: 320px;">
            <option value="">Cargando snapshots...</option>
        </select>
        <button type="button" id="matching-rematch-btn" class="btn btn-sm btn-primary">
            <i class="bi bi-arrow-repeat me-1"></i>Recalcular coincidencias
        </button>
    </div>
</div>

<div id="matching-summary-area" class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-primary-subtle text-primary-emphasis"><i class="bi bi-hdd-network fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Dispositivos</div>
                    <div class="fs-4 fw-bold" id="kpi-total">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-success-subtle text-success-emphasis"><i class="bi bi-check2-circle fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Coincididos</div>
                    <div class="fs-4 fw-bold text-success" id="kpi-matched">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-danger-subtle text-danger-emphasis"><i class="bi bi-x-circle fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Sin coincidir</div>
                    <div class="fs-4 fw-bold text-danger" id="kpi-unmatched">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-info-subtle text-info-emphasis"><i class="bi bi-graph-up-arrow fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Tasa de cruce</div>
                    <div class="fs-4 fw-bold" id="kpi-rate">0%</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card telemetry-card h-100">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">Metodo de coincidencia</h6>
            </div>
            <div class="card-body" id="match-key-area">
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-muted">Sin datos</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card telemetry-card h-100">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">Riesgo por estado de cruce</h6>
            </div>
            <div class="card-body" id="risk-breakdown-area">
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-muted">Sin datos</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card telemetry-card mb-3">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h6 class="mb-0 fw-semibold">Top dispositivos sin inventario</h6>
    </div>
    <div class="card-body p-0" id="top-unmatched-area">
        <div class="telemetry-loading-shell m-3">
            <div class="telemetry-loading-content">
                <span class="text-muted">Sin datos</span>
            </div>
        </div>
    </div>
</div>

<div class="card telemetry-card">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h6 class="mb-0 fw-semibold">Detalle de cruce</h6>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <input type="search" id="matching-search" class="form-control form-control-sm" placeholder="Buscar equipo, usuario, IP..." style="width: 240px;">
            <select id="matching-state-select" class="form-select form-select-sm" style="width: 150px;">
                <option value="">Todos</option>
                <option value="matched">Coincididos</option>
                <option value="unmatched">Sin coincidir</option>
            </select>
            <select id="matching-risk-select" class="form-select form-select-sm" style="width: 130px;">
                <option value="">Todo riesgo</option>
                <option value="critical">Critico</option>
                <option value="high">Alto</option>
                <option value="medium">Medio</option>
                <option value="low">Bajo</option>
            </select>
        </div>
    </div>
    <div class="card-body">
        <div id="matching-table" class="mb-2"></div>
        <div id="matching-pagination" class="d-flex justify-content-center gap-2"></div>
    </div>
</div>

<script>
window.addEventListener("DOMContentLoaded", () => {
    const snapshotsSeed = @Html.Raw(ViewData["SnapshotsJson"] as string ?? "[]");
    const activeSnapshotId = "@(ViewData["ActiveSnapshotId"]?.ToString() ?? "")";
    const summarySeed = @Html.Raw(ViewData["SummaryJson"] as string ?? "{}");
    const initialPageSeed = @Html.Raw(ViewData["InitialMatchesPageJson"] as string ?? "{}");
    const noSnapshotId = "00000000-0000-0000-0000-000000000000";

    const snapshotSelect = document.getElementById("matching-snapshot-select");
    const rematchBtn = document.getElementById("matching-rematch-btn");
    const searchInput = document.getElementById("matching-search");
    const stateSelect = document.getElementById("matching-state-select");
    const riskSelect = document.getElementById("matching-risk-select");
    const table = document.getElementById("matching-table");
    const pagination = document.getElementById("matching-pagination");

    let currentSnapshotId = activeSnapshotId || noSnapshotId;
    let latestPage = null;
    let latestSummary = null;

    const formatKeyLabel = (key) => {
        switch ((key || "").toLowerCase()) {
            case "serial": return "Serie";
            case "mac": return "MAC";
            case "ip": return "IP exacta";
            case "ip_in_name": return "IP en nombre";
            case "inventario": return "Inventario";
            default: return key || "Sin etiqueta";
        }
    };

    const riskPill = (level, score) =>
        `<span class="telemetry-pill telemetry-pill-${(level || "unknown").toLowerCase()}">${(level || "")} (${score ?? 0})</span>`;

    const matchPill = (matched) =>
        matched
            ? '<span class="telemetry-pill telemetry-pill-matched">Coincidido</span>'
            : '<span class="telemetry-pill telemetry-pill-unmatched">Sin coincidir</span>';

    const renderSnapshotSelect = () => {
        snapshotSelect.innerHTML = "";
        if (!Array.isArray(snapshotsSeed) || snapshotsSeed.length === 0) {
            snapshotSelect.innerHTML = '<option value="">Sin snapshots</option>';
            return;
        }

        snapshotsSeed.forEach((snap) => {
            const option = document.createElement("option");
            option.value = snap.id;
            const observedAt = snap.observedAtUtc ? new Date(snap.observedAtUtc).toLocaleString("es-CL") : "";
            const captureLabel = snap.runNumber ? `#${snap.runNumber}` : "";
            option.textContent = `${captureLabel}${captureLabel ? " " : ""}${snap.sourceName || "Telemetria"} | ${observedAt} | ${snap.riskLevel || ""} (${snap.deviceCount ?? 0} disp)`;
            option.title = snap.runNumber
                ? `Captura #${snap.runNumber}`
                : (snap.id ? `Snapshot ${snap.id}` : "");
            option.selected = snap.id === currentSnapshotId;
            snapshotSelect.appendChild(option);
        });
    };

    const renderSummary = (summary) => {
        if (!summary || summary.found === false) {
            document.getElementById("kpi-total").textContent = "0";
            document.getElementById("kpi-matched").textContent = "0";
            document.getElementById("kpi-unmatched").textContent = "0";
            document.getElementById("kpi-rate").textContent = "0%";
            document.getElementById("match-key-area").innerHTML = '<span class="badge bg-light text-muted">Snapshot sin datos</span>';
            document.getElementById("risk-breakdown-area").innerHTML = '<span class="badge bg-light text-muted">Snapshot sin datos</span>';
            document.getElementById("top-unmatched-area").innerHTML = '<div class="p-4 text-center text-muted">Selecciona una snapshot con datos.</div>';
            return;
        }

        document.getElementById("kpi-total").textContent = summary.deviceCount ?? 0;
        document.getElementById("kpi-matched").textContent = summary.matchedCount ?? 0;
        document.getElementById("kpi-unmatched").textContent = summary.unmatchedCount ?? 0;
        document.getElementById("kpi-rate").textContent = `${summary.matchRate ?? 0}%`;

        const keyCounts = summary.matchKeyCounts || {};
        const keyEntries = Object.entries(keyCounts).sort((a, b) => b[1] - a[1]);
        const keyArea = document.getElementById("match-key-area");
        keyArea.innerHTML = keyEntries.length === 0
            ? '<span class="badge bg-light text-muted">Sin coincidencias con clave</span>'
            : keyEntries.map(([key, count]) =>
                `<span class="badge bg-info-subtle text-info-emphasis fs-6">${formatKeyLabel(key)}: ${count}</span>`).join(" ") +
              '<div class="small text-muted mt-2">Clave usada por el motor heuristico al cruzar con el inventario.</div>';

        const matchedByRisk = summary.matchedByRiskLevel || {};
        const unmatchedByRisk = summary.unmatchedByRiskLevel || {};
        const riskArea = document.getElementById("risk-breakdown-area");
        const riskLevels = [
            { key: "critical", label: "Critico", cls: "text-danger" },
            { key: "high",     label: "Alto",    cls: "text-warning" },
            { key: "medium",   label: "Medio",   cls: "text-info" },
            { key: "low",      label: "Bajo",    cls: "text-success" }
        ];
        const rows = riskLevels.map(({ key, label, cls }) => {
            const m = matchedByRisk[key] ?? 0;
            const u = unmatchedByRisk[key] ?? 0;
            const total = m + u;
            const pct = total > 0 ? Math.round((m / total) * 100) : 0;
            return `<tr>
                <td class="fw-semibold ${cls}">${label}</td>
                <td class="text-center">${m}</td>
                <td class="text-center">${u}</td>
                <td style="width:40%">
                    <div class="d-flex align-items-center gap-2">
                        <div class="flex-grow-1" style="height:8px;background:#e2e8f0;border-radius:4px;overflow:hidden;">
                            <div style="width:${pct}%;height:100%;background:${cls === "text-danger" ? "#ef4444" : cls === "text-warning" ? "#f59e0b" : cls === "text-info" ? "#0ea5e9" : "#22c55e"};border-radius:4px;"></div>
                        </div>
                        <span class="small text-muted" style="min-width:32px;text-align:right;">${pct}%</span>
                    </div>
                </td>
            </tr>`;
        }).join("");
        riskArea.innerHTML = `
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Estado</th>
                        <th class="text-center">Coincididos</th>
                        <th class="text-center">Sin coincidir</th>
                        <th>Proporcion</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>`;

        const topUnmatched = Array.isArray(summary.topUnmatched) ? summary.topUnmatched : [];
        const topArea = document.getElementById("top-unmatched-area");
        if (topUnmatched.length === 0) {
            topArea.innerHTML = '<div class="p-4 text-center text-muted">No hay dispositivos sin coincidencia.</div>';
        } else {
            topArea.innerHTML = `
                <div class="table-responsive">
                    <table class="table align-middle table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th>Usuario</th>
                                <th>IP</th>
                                <th>Hostname</th>
                                <th>Riesgo</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${topUnmatched.map((item) => `
                                <tr>
                                    <td class="fw-semibold">${item.deviceName || "Sin nombre"}</td>
                                    <td>${item.username || ""}</td>
                                    <td>${item.ipAddress || ""}</td>
                                    <td>${item.hostName || ""}</td>
                                    <td>${riskPill(item.riskLevel, item.riskScore)}</td>
                                </tr>`).join("")}
                        </tbody>
                    </table>
                </div>`;
        }
    };

    const buildSortableHeader = (label, sortKey) => {
        const sortBy = latestPage?.sortBy || "risk";
        const direction = latestPage?.sortDirection || "desc";
        const active = sortBy === sortKey ? "is-active" : "";
        const icon = sortBy === sortKey
            ? (direction === "asc" ? '<i class="bi bi-arrow-up"></i>' : '<i class="bi bi-arrow-down"></i>')
            : '<i class="bi bi-arrow-down-up"></i>';
        return `<button type="button" class="telemetry-sort-button ${active}" data-sort="${sortKey}">${label} ${icon}</button>`;
    };

    const toggleSort = (currentSortBy, currentDirection, nextSortBy) =>
        currentSortBy === nextSortBy ? (currentDirection === "asc" ? "desc" : "asc") : "asc";

    const renderTable = (data) => {
        const items = Array.isArray(data?.items) ? data.items : [];
        const totalCount = Number(data?.totalCount) || 0;
        const page = Number(data?.page) || 1;
        const totalPages = Number(data?.totalPages) || 1;
        latestPage = data;

        if (items.length === 0) {
            table.innerHTML = '<div class="text-muted p-4 text-center">No se encontraron dispositivos con esos filtros.</div>';
        } else {
            const sortBy = data?.sortBy || "risk";
            const direction = data?.sortDirection || "desc";
            table.innerHTML = `
                <div class="telemetry-table-wrap table-responsive">
                    <table class="table align-middle table-sm">
                        <thead>
                            <tr>
                                <th>${buildSortableHeader("Equipo", "deviceName")}</th>
                                <th>Usuario</th>
                                <th>IP</th>
                                <th>S/N</th>
                                <th>Clave</th>
                                <th>Estado</th>
                                <th>Item inventario</th>
                                <th>Responsable</th>
                                <th>Asignado a</th>
                                <th>${buildSortableHeader("Riesgo", "risk")}</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map((item) => `
                                <tr>
                                    <td>
                                        <div class="fw-semibold">${item.deviceName || item.hostName || "Sin nombre"}</div>
                                        <div class="small text-muted">${item.hostName || ""}</div>
                                    </td>
                                    <td>${item.username || ""}</td>
                                    <td>${item.ipAddress || ""}</td>
                                    <td>${item.serialNumber || item.macAddress || ""}</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary-emphasis">${formatKeyLabel(item.matchKey)}</span></td>
                                    <td>${matchPill(item.matched)}</td>
                                    <td>
                                        ${item.matched
                                            ? `<div class="small fw-semibold">${item.inventoryItemNumber || item.inventorySerial || "Item"}</div>
                                               <div class="small text-muted">${item.inventoryDescription || item.inventorySerial || ""}</div>`
                                            : '<span class="text-muted small">-</span>'}
                                    </td>
                                    <td>
                                        ${item.matched
                                            ? `<div class="small">${item.inventoryResponsibleUser || "-"}</div>
                                               <div class="small text-muted">${item.inventoryEmail || ""}</div>`
                                            : '<span class="text-muted small">-</span>'}
                                    </td>
                                    <td>
                                        ${item.matched
                                            ? `<div class="small">${item.inventoryAssignedBuildingExternalId || "-"}</div>
                                               <div class="small text-muted">${item.inventoryAssignedRoomExternalId || ""}</div>`
                                            : `<div class="small">${item.buildingExternalId || "-"}</div>
                                               <div class="small text-muted">${item.roomExternalId || ""}</div>`}
                                    </td>
                                    <td>${riskPill(item.riskLevel, item.riskScore)}</td>
                                </tr>`).join("")}
                        </tbody>
                    </table>
                </div>`;

            table.querySelectorAll("[data-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextSortBy = button.getAttribute("data-sort") || "risk";
                    const nextDirection = toggleSort(latestPage?.sortBy || "risk", latestPage?.sortDirection || "desc", nextSortBy);
                    loadMatches(1, nextSortBy, nextDirection);
                });
            });
        }

        const previousDisabled = page <= 1 ? "disabled" : "";
        const nextDisabled = page >= totalPages ? "disabled" : "";
        pagination.innerHTML = `
            <button type="button" class="btn btn-outline-secondary btn-sm" ${previousDisabled} data-page="${page - 1}">Anterior</button>
            <span class="align-self-center small text-muted">Pagina ${page} de ${totalPages} (${totalCount})</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" ${nextDisabled} data-page="${page + 1}">Siguiente</button>`;

        pagination.querySelectorAll("[data-page]").forEach((button) => {
            button.addEventListener("click", () => {
                const nextPage = Number(button.getAttribute("data-page"));
                if (Number.isFinite(nextPage) && nextPage >= 1) {
                    loadMatches(nextPage);
                }
            });
        });
    };

    const renderLoading = () => {
        table.innerHTML = `
            <div class="telemetry-loading-shell">
                <div class="telemetry-loading-content">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <div class="fw-semibold">Cargando cruces...</div>
                </div>
            </div>`;
        pagination.innerHTML = "";
    };

    const loadMatches = (page = 1, sortBy, sortDirection) => {
        if (!currentSnapshotId || currentSnapshotId === noSnapshotId) {
            table.textContent = "Selecciona una snapshot para ver el detalle de cruce.";
            pagination.innerHTML = "";
            return;
        }

        renderLoading();

        const params = new URLSearchParams({
            page: String(page),
            pageSize: "25",
            search: searchInput.value.trim() || "",
            matchState: stateSelect.value || "",
            riskLevel: riskSelect.value || "",
            sortBy: sortBy || latestPage?.sortBy || "risk",
            sortDirection: sortDirection || latestPage?.sortDirection || "desc"
        });

        fetch(`/api/network-telemetry/snapshots/${currentSnapshotId}/matches?${params.toString()}`, {
            credentials: "include",
            headers: { "Accept": "application/json" }
        })
            .then((response) => {
                if (!response.ok) throw new Error(`La API respondio ${response.status}`);
                return response.json();
            })
            .then(renderTable)
            .catch((error) => {
                console.error("Error cargando cruces:", error);
                table.innerHTML = '<div class="text-danger p-4 text-center">No se pudo cargar el detalle de cruce.</div>';
                pagination.innerHTML = "";
            });
    };

    const loadSummary = () => {
        if (!currentSnapshotId || currentSnapshotId === noSnapshotId) {
            renderSummary(null);
            return;
        }

        const summaryParams = new URLSearchParams();
        const summaryQuery = summaryParams.toString();

        fetch(`/api/network-telemetry/snapshots/${currentSnapshotId}/matching-summary${summaryQuery ? `?${summaryQuery}` : ""}`, {
            credentials: "include",
            headers: { "Accept": "application/json" }
        })
            .then((response) => {
                if (!response.ok) throw new Error(`La API respondio ${response.status}`);
                return response.json();
            })
            .then((summary) => {
                latestSummary = summary;
                renderSummary(summary);
            })
            .catch((error) => {
                console.error("Error cargando resumen:", error);
                latestSummary = null;
                renderSummary(null);
            });
    };

    const onSnapshotChange = () => {
        currentSnapshotId = snapshotSelect.value || noSnapshotId;
        latestPage = null;
        history.replaceState(null, "", `/dashboard/network-telemetry/matching?snapshotId=${currentSnapshotId}`);
        loadSummary();
        loadMatches(1);
    };

    const runRematch = () => {
        if (!currentSnapshotId || currentSnapshotId === noSnapshotId) {
            alert("Selecciona una snapshot primero.");
            return;
        }

        if (!confirm("Se recalcularan las coincidencias de inventario de esta snapshot usando el motor heuristico. Continuar?")) {
            return;
        }

        rematchBtn.disabled = true;
        rematchBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Recalculando...';

        const rematchParams = new URLSearchParams();
        const rematchQuery = rematchParams.toString();

        fetch(`/api/network-telemetry/snapshots/${currentSnapshotId}/rematch${rematchQuery ? `?${rematchQuery}` : ""}`, {
            method: "POST",
            credentials: "include",
            headers: { "Accept": "application/json" }
        })
            .then((response) => {
                if (!response.ok) throw new Error(`La API respondio ${response.status}`);
                return response.json();
            })
            .then((result) => {
                alert(`Recalculo completado: ${result.matchedCount} coincidencias, ${result.unmatchedCount} sin coincidir, ${result.changedCount} cambios.`);
                loadSummary();
                loadMatches(1);
            })
            .catch((error) => {
                console.error("Error recalculando coincidencias:", error);
                alert("No se pudo recalcular las coincidencias.");
            })
            .finally(() => {
                rematchBtn.disabled = false;
                rematchBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Recalcular coincidencias';
            });
    };

    let searchTimer = null;
    searchInput.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => loadMatches(1), 350);
    });
    stateSelect.addEventListener("change", () => loadMatches(1));
    riskSelect.addEventListener("change", () => loadMatches(1));
    snapshotSelect.addEventListener("change", onSnapshotChange);
    rematchBtn.addEventListener("click", runRematch);

    snapshotSelect.disabled = false;
    if (rematchBtn) {
        rematchBtn.disabled = false;
    }

    renderSnapshotSelect();

    if (summarySeed && summarySeed.found === true && summarySeed.snapshotId === currentSnapshotId) {
        latestSummary = summarySeed;
        renderSummary(summarySeed);
    } else {
        loadSummary();
    }

    if (initialPageSeed
        && Array.isArray(initialPageSeed.items)
        && initialPageSeed.snapshotId === currentSnapshotId) {
        renderTable(initialPageSeed);
    } else {
        loadMatches(1);
    }
});
</script>
