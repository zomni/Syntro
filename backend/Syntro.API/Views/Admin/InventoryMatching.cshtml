@using System.Text.Json
@using System.Text.Json.Serialization
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Coincidencias inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var telemetryJsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
    var displayTimeZoneId = Syntro.API.Services.TelemetryTimeSettings.ResolveTimeZone(Config).Id;
    var displayLocale = Syntro.API.Services.TelemetryTimeSettings.ResolveLocale(Config);
}

<style>
    .telemetry-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .telemetry-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .telemetry-card .card-header {
        border-bottom: 1px solid rgba(226, 232, 240, 0.7);
        padding: 1rem 1.25rem;
        position: relative;
    }
    .telemetry-card .card-header::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: 0 4px 4px 0;
        background: linear-gradient(180deg, #2d79a0, #38bdf8);
    }
    .telemetry-kpi {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .telemetry-card:hover .telemetry-kpi {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }
    .matching-context-strip {
        border: 0;
        border-radius: 18px;
        background: linear-gradient(135deg, #0f172a 0%, #1f3b57 52%, #184e77 100%);
        color: #fff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
    }
    .matching-context-strip .form-select {
        min-width: min(100%, 540px);
        border-color: rgba(255, 255, 255, 0.25);
        background-color: rgba(255, 255, 255, 0.96);
    }
    .matching-context-meta { color: rgba(255, 255, 255, 0.72); }
    .matching-summary-card .card-body { height: 100%; }
    .matching-kpi-tile { min-height: 116px; }
    .matching-summary-note { color: #64748b; }
    .matching-method-badge { min-width: 96px; justify-content: center; }
    .matching-method-weak { opacity: .72; }
    .matching-method-weak .matching-method-badge { border-style: dashed !important; }
    .matching-risk-track { position: relative; height: 10px; min-width: 120px; border-radius: 999px; background: #e2e8f0; overflow: visible; }
    .matching-risk-track > div { height: 100%; min-width: 4px; display: flex; border-radius: inherit; overflow: hidden; }
    .matching-risk-count { white-space: nowrap; color: #475569; font-size: .78rem; }
    .matching-risk-legend { display: flex; flex-wrap: wrap; gap: .75rem 1rem; color: #64748b; font-size: .78rem; }
    .matching-risk-legend span { display: inline-flex; align-items: center; gap: .35rem; }
    .matching-risk-legend i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
    .matching-info-alert { border: 0; border-left: 3px solid #f59e0b; background: #fffbeb; color: #92400e; }
    .matching-filter-chip { border: 1px solid #cbd5e1; background: #fff; color: #475569; }
    .matching-filter-chip:hover { border-color: #0f766e; color: #0f766e; }
    .matching-filter-chip:focus-visible { outline: 3px solid rgba(14, 165, 233, .45); outline-offset: 2px; }
    .matching-filter-chip.is-active { border-color: #0f766e; background: #0f766e; color: #fff; box-shadow: 0 0 0 2px rgba(15, 118, 110, .16); }
    .matching-muted-value { color: #64748b; font-weight: 400; }
    .telemetry-table-wrap {
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 16px;
        overflow: hidden;
    }
    .telemetry-table-wrap table {
        margin-bottom: 0;
    }
    .telemetry-table-wrap thead th {
        background: #f8fafc;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        vertical-align: middle;
        white-space: nowrap;
    }
    .telemetry-table-wrap tbody tr:hover {
        background: rgba(14, 165, 233, 0.05);
    }
    .telemetry-sort-button {
        border: 0;
        background: transparent;
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        white-space: nowrap;
    }
    .telemetry-sort-button i {
        font-size: 0.75rem;
        color: #94a3b8;
    }
    .telemetry-sort-button.is-active i {
        color: #003366;
    }
    .telemetry-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .telemetry-pill-critical { background: #fee2e2; color: #b91c1c; }
    .telemetry-pill-high { background: #ffedd5; color: #c2410c; }
    .telemetry-pill-medium { background: #fef3c7; color: #a16207; }
    .telemetry-pill-low { background: #dcfce7; color: #15803d; }
    .telemetry-pill-unknown { background: #e2e8f0; color: #475569; }
    .telemetry-pill-matched { background: #dcfce7; color: #15803d; }
    .telemetry-pill-unmatched { background: #fee2e2; color: #b91c1c; }
    .match-method-row { display: grid; grid-template-columns: minmax(110px, 1fr) auto; gap: .6rem; align-items: center; }
    .match-method-bar, .risk-level-bar { height: 9px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
    .match-method-fill { height: 100%; border-radius: inherit; background: #0ea5e9; }
    .match-method-weak .match-method-fill { background: #94a3b8; }
    .risk-level-row { display: grid; grid-template-columns: 76px 58px minmax(150px, 1fr) 52px; gap: .65rem; align-items: center; }
    .risk-level-bar { min-width: 4px; }
    .risk-level-bar-inner { height: 100%; min-width: 4px; display: flex; border-radius: inherit; overflow: hidden; }
    .risk-segment-matched { background: #16a34a; }
    .risk-segment-unmatched { background: #dc2626; }
    .matching-filter-label { display: block; margin-bottom: .2rem; color: #64748b; font-size: .75rem; font-weight: 600; }
    .matching-count-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
    .telemetry-pill-risk-critical { background: #fee2e2; color: #b91c1c; }
    .telemetry-pill-risk-high { background: #ffedd5; color: #c2410c; }
    .telemetry-pill-risk-medium { background: #fef3c7; color: #a16207; }
    .telemetry-pill-risk-low { background: #dcfce7; color: #15803d; }
    @@media (max-width: 767.98px) {
        .risk-level-row { grid-template-columns: 68px 44px minmax(90px, 1fr) 44px; gap: .35rem; }
    }
    .match-chip {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: #f8fafc;
        color: #475569;
        cursor: pointer;
        user-select: none;
        transition: background .2s ease, color .2s ease, border-color .2s ease;
    }
    .match-chip.is-active {
        background: #003366;
        border-color: #003366;
        color: #ffffff;
    }
    .telemetry-loading-shell {
        min-height: 320px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 16px;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
    }
    .telemetry-loading-content {
        display: grid;
        gap: 10px;
        justify-items: center;
        text-align: center;
        color: #64748b;
    }
</style>

<div class="matching-context-strip p-3 p-lg-4 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="small text-uppercase fw-semibold matching-context-meta mb-1"><i class="bi bi-diagram-3 me-1"></i>Contexto de cruce</div>
            <h2 class="fw-bold mb-0 fs-4">Coincidencias de inventario</h2>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
            <select id="matching-snapshot-select" class="form-select form-select-sm w-mobile-100">
                <option value="">Cargando snapshots...</option>
            </select>
            <span id="matching-active-chip" class="badge rounded-pill bg-info-subtle text-info-emphasis">Activo</span>
            <span id="matching-calculation-label" class="small matching-context-meta text-nowrap">Capturado: -</span>
            @if (User.IsInRole(Syntro.API.Models.AppRoles.Admin))
            {
                <button type="button" id="matching-rematch-btn" class="btn btn-sm btn-light text-primary fw-semibold">
                    <i class="bi bi-arrow-repeat me-1"></i>Recalcular
                </button>
            }
        </div>
    </div>
</div>

<div class="card telemetry-card telemetry-card-static mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Resumen del cruce</h5>
            <span class="badge bg-light text-muted">Snapshot seleccionado</span>
        </div>
        <div id="matching-summary-area" class="row g-3">
    <div class="col-md-3">
        <div class="card telemetry-card matching-summary-card h-100">
            <div class="card-body matching-kpi-tile d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-primary-subtle text-primary-emphasis"><i class="bi bi-hdd-network fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Dispositivos</div>
                    <div class="fs-4 fw-bold" id="kpi-total">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card telemetry-card matching-summary-card h-100">
            <div class="card-body matching-kpi-tile d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-success-subtle text-success-emphasis"><i class="bi bi-check2-circle fs-4"></i></div>
                <div>
                             <div class="small text-muted text-uppercase">Coincidentes</div>
                    <div class="fs-4 fw-bold text-success" id="kpi-matched">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card telemetry-card matching-summary-card h-100">
            <div class="card-body matching-kpi-tile d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-danger-subtle text-danger-emphasis"><i class="bi bi-x-circle fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Sin coincidir</div>
                    <div class="fs-4 fw-bold text-danger" id="kpi-unmatched">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card telemetry-card matching-summary-card h-100">
            <div class="card-body matching-kpi-tile d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-info-subtle text-info-emphasis"><i class="bi bi-graph-up-arrow fs-4"></i></div>
                <div>
                    <div class="small text-muted text-uppercase">Tasa de cruce</div>
                     <div class="fs-4 fw-bold" id="kpi-rate">0%</div>
                     <div class="small text-muted" id="kpi-rate-base">0 de 0 dispositivos</div>
                </div>
            </div>
        </div>
    </div>
</div>
        <div id="matching-summary-note" class="matching-summary-note small mt-3">Cobertura de inventario: -</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card telemetry-card h-100">
            <div class="card-header">
                         <h6 class="mb-0 fw-semibold">Método de coincidencia</h6>
            </div>
            <div class="card-body" id="match-key-area">
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-muted">Sin datos</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card telemetry-card h-100">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">Riesgo por estado de cruce</h6>
            </div>
            <div class="card-body" id="risk-breakdown-area">
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-muted">Sin datos</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card telemetry-card">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h6 class="mb-0 fw-semibold">Detalle de cruce</h6>
         <div class="d-flex flex-wrap align-items-end gap-2">
             <div><label class="matching-filter-label" for="matching-search">Buscar</label><input type="search" id="matching-search" class="form-control form-control-sm w-mobile-100" placeholder="Equipo, usuario, IP..." style="width: 220px;"></div>
             <div>
                 <span class="matching-filter-label">Estado</span>
                 <div id="matching-state-chips" class="matching-count-chips" role="group" aria-label="Filtrar por estado de coincidencia"></div>
             </div>
             <div><label class="matching-filter-label" for="matching-risk-select">Nivel de riesgo</label><select id="matching-risk-select" class="form-select form-select-sm w-mobile-100" style="width: 130px;">
                 <option value="">Todo riesgo</option>
                 <option value="critical">Crítico</option>
                 <option value="high">Alto</option>
                 <option value="medium">Medio</option>
                 <option value="low">Bajo</option>
             </select></div>
             <div><label class="matching-filter-label" for="matching-page-size">Cantidad por página</label><select id="matching-page-size" class="form-select form-select-sm" style="width: 145px;"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option></select></div>
         </div>
     </div>
     <div class="card-body">
         <div id="matching-table" class="mb-2"></div>
        <div id="matching-pagination" class="d-flex justify-content-center gap-2"></div>
    </div>
</div>

<script>
window.addEventListener("DOMContentLoaded", () => {
    const snapshotsSeed = @Html.Raw(ViewData["SnapshotsJson"] as string ?? "[]");
    const activeSnapshotId = "@(ViewData["ActiveSnapshotId"]?.ToString() ?? "")";
    const summarySeed = @Html.Raw(ViewData["SummaryJson"] as string ?? "{}");
    const initialPageSeed = @Html.Raw(ViewData["InitialMatchesPageJson"] as string ?? "{}");
    const noSnapshotId = "00000000-0000-0000-0000-000000000000";

    const snapshotSelect = document.getElementById("matching-snapshot-select");
    const rematchBtn = document.getElementById("matching-rematch-btn");
    const searchInput = document.getElementById("matching-search");
    const stateChips = document.getElementById("matching-state-chips");
    const riskSelect = document.getElementById("matching-risk-select");
    const pageSizeSelect = document.getElementById("matching-page-size");
    const table = document.getElementById("matching-table");
    const pagination = document.getElementById("matching-pagination");
    const matchingSummaryNote = document.getElementById("matching-summary-note");

    let currentSnapshotId = activeSnapshotId || noSnapshotId;
    let activeMatchState = "";
    let latestPage = null;
    let latestSummary = null;

    const parseApiUtcDate = (value) => {
        if (!value) return null;
        if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;
        const text = String(value).trim();
        if (!text) return null;
        const normalized = /z|[+\-]\d{2}:\d{2}$/i.test(text) ? text : `${text}Z`;
        const parsed = new Date(normalized);
        return Number.isNaN(parsed.getTime()) ? null : parsed;
    };
    const formatDateTime = (value) => {
        const parsed = parseApiUtcDate(value);
        if (!parsed) return "";
        const parts = new Intl.DateTimeFormat("@displayLocale", {
            timeZone: "@displayTimeZoneId",
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            hourCycle: "h23"
        }).formatToParts(parsed).reduce((result, part) => ({ ...result, [part.type]: part.value }), {});
        return `${parts.day}-${parts.month}-${parts.year} ${parts.hour}:${parts.minute}`;
    };
    const riskLabel = (level) => ({ critical: "Crítico", high: "Alto", medium: "Medio", low: "Bajo", unknown: "Sin dato" }[String(level || "unknown").toLowerCase()] || "Sin dato");
    const formatKeyLabel = (key) => {
        switch ((key || "").toLowerCase()) {
            case "serial": return "Serie";
            case "mac": return "MAC";
            case "ip": return "IP exacta";
            case "ip_in_name": return "IP en nombre";
            case "inventario": return "Inventario";
            default: return key || "Sin método";
        }
    };

    const riskPill = (level, score) =>
        `<span class="telemetry-pill telemetry-pill-${(level || "unknown").toLowerCase()}">${riskLabel(level)} (${score ?? 0})</span>`;

    const matchPill = (matched) =>
        matched
            ? '<span class="telemetry-pill telemetry-pill-matched">Coincidente</span>'
            : '<span class="telemetry-pill telemetry-pill-unmatched">Sin coincidir</span>';

    const renderSnapshotSelect = () => {
        snapshotSelect.innerHTML = "";
        if (!Array.isArray(snapshotsSeed) || snapshotsSeed.length === 0) {
            snapshotSelect.innerHTML = '<option value="">Sin snapshots</option>';
            return;
        }

        snapshotsSeed.forEach((snap) => {
            const option = document.createElement("option");
            option.value = snap.id;
            const captureLabel = snap.runNumber ? `#${snap.runNumber}` : "Snapshot";
            option.textContent = `${captureLabel} · ${formatDateTime(snap.observedAtUtc)} · ${snap.deviceCount ?? 0} equipos · ${riskLabel(snap.riskLevel)} (${snap.riskScore ?? 0})${snap.id === currentSnapshotId ? " · Activo" : ""}`;
            option.title = snap.runNumber
                ? `Captura #${snap.runNumber}`
                : (snap.id ? `Snapshot ${snap.id}` : "");
            option.selected = snap.id === currentSnapshotId;
            snapshotSelect.appendChild(option);
        });
    };

    const renderSummary = (summary) => {
        if (!summary || summary.found === false) {
            document.getElementById("kpi-total").textContent = "0";
            document.getElementById("kpi-matched").textContent = "0";
            document.getElementById("kpi-unmatched").textContent = "0";
            document.getElementById("kpi-rate").textContent = "0%";
            document.getElementById("kpi-rate-base").textContent = "0 de 0 dispositivos";
            matchingSummaryNote.textContent = "Cobertura de inventario: -";
            stateChips.innerHTML = "";
            document.getElementById("matching-calculation-label").textContent = "Capturado: -";
            document.getElementById("match-key-area").innerHTML = '<span class="badge bg-light text-muted">Snapshot sin datos</span>';
            document.getElementById("risk-breakdown-area").innerHTML = '<span class="badge bg-light text-muted">Snapshot sin datos</span>';
            return;
        }

        document.getElementById("kpi-total").textContent = summary.deviceCount ?? 0;
        document.getElementById("kpi-matched").textContent = summary.matchedCount ?? 0;
        document.getElementById("kpi-unmatched").textContent = summary.unmatchedCount ?? 0;
        const matchRate = summary.deviceCount > 0 ? Math.round((summary.matchedCount / summary.deviceCount) * 100) : 0;
        const coverageRate = summary.inventoryCount > 0 ? Math.round((summary.observedInventoryCount / summary.inventoryCount) * 100) : 0;
        document.getElementById("kpi-rate").textContent = `${matchRate}%`;
        document.getElementById("kpi-rate-base").textContent = `${summary.matchedCount ?? 0} de ${summary.deviceCount ?? 0} dispositivos`;
        matchingSummaryNote.textContent = `Cobertura de inventario: ${coverageRate}% (${summary.observedInventoryCount ?? 0} de ${summary.inventoryCount ?? 0})`;
        stateChips.innerHTML = [
            ["", "Todos", summary.deviceCount ?? 0],
            ["matched", "Coincidentes", summary.matchedCount ?? 0],
            ["unmatched", "Sin coincidencia", summary.unmatchedCount ?? 0]
        ].map(([value, label, count]) => `<button type="button" class="btn btn-sm rounded-pill matching-filter-chip ${activeMatchState === value ? "is-active" : ""}" data-match-state="${value}" aria-pressed="${activeMatchState === value}">${label}: ${count}</button>`).join("");
        stateChips.querySelectorAll("[data-match-state]").forEach((chip) => chip.addEventListener("click", () => {
            activeMatchState = chip.dataset.matchState || "";
            renderSummary(summary);
            loadMatches(1);
        }));

        const keyCounts = summary.matchKeyCounts || {};
        const keyEntries = Object.entries(keyCounts).sort((a, b) => b[1] - a[1]);
        const keyArea = document.getElementById("match-key-area");
        const matchedTotal = Math.max(1, Number(summary.matchedCount) || 0);
        keyArea.innerHTML = keyEntries.length === 0
            ? '<span class="badge bg-light text-muted">Sin coincidencias con método</span>'
            : keyEntries.map(([key, count]) => {
                const pct = Math.round((count / matchedTotal) * 100);
                const weak = key === "ip" || key === "ip_in_name";
                return `<div class="match-method-row ${weak ? "match-method-weak" : ""} mb-2"><span class="badge bg-primary-subtle text-primary-emphasis matching-method-badge">${formatKeyLabel(key)} <strong>${count}</strong> <span class="small">(${pct}%)</span>${weak ? ' <span class="d-block small fw-normal">menor confianza</span>' : ""}</span><div class="match-method-bar" title="${pct}% de las coincidencias"><div class="match-method-fill" style="width:${Math.max(2, pct)}%"></div></div></div>`;
            }).join("") +
              '<div class="small text-muted mt-3">Proporción sobre los dispositivos coincidentes. IP exacta e IP en nombre son métodos de menor estabilidad que serie o MAC.</div>';

        const matchedByRisk = summary.matchedByRiskLevel || {};
        const unmatchedByRisk = summary.unmatchedByRiskLevel || {};
        const riskArea = document.getElementById("risk-breakdown-area");
        const riskLevels = [
            { key: "critical", label: "Crítico" },
            { key: "high",     label: "Alto" },
            { key: "medium",   label: "Medio" },
            { key: "low",      label: "Bajo" }
        ];
        const riskColors = {
            critical: ["#fecaca", "#ef4444"],
            high: ["#fed7aa", "#f97316"],
            medium: ["#fef08a", "#eab308"],
            low: ["#bbf7d0", "#22c55e"]
        };
        const snapshotTotal = Math.max(1, Number(summary.deviceCount) || 0);
        const rows = riskLevels.map(({ key, label }) => {
            const m = matchedByRisk[key] ?? 0;
            const u = unmatchedByRisk[key] ?? 0;
            const total = m + u;
            const levelPct = total > 0 ? (total / snapshotTotal) * 100 : 0;
            const matchedPct = total > 0 ? (m / total) * 100 : 0;
            const colors = riskColors[key] || ["#cbd5e1", "#64748b"];
            return `<tr>
                <td class="fw-semibold">${label}</td>
                <td class="text-end">${total}</td>
                <td class="text-end">${m}</td>
                <td class="text-end">${u}</td>
                <td><div class="d-flex align-items-center gap-2"><div class="matching-risk-track" style="width:${Math.max(1.5, levelPct)}%" title="${total} de ${snapshotTotal} equipos"><div><div style="width:${matchedPct}%;background:${colors[0]}"></div><div style="width:${100 - matchedPct}%;background:${colors[1]}"></div></div></div><span class="matching-risk-count">${Math.round(levelPct)}%</span></div></td>
            </tr>`;
        }).join("");
        riskArea.innerHTML = `
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nivel de riesgo</th>
                        <th class="text-end">Equipos</th>
                        <th class="text-end">Coincidentes</th>
                        <th class="text-end">Sin coincidir</th>
                        <th>Proporción del snapshot</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
            <div class="matching-risk-legend mt-2"><span><i style="background:#16a34a"></i>Coincidentes</span><span><i style="background:#dc2626"></i>Sin coincidir</span><span>La proporción es el total del nivel sobre todos los equipos del snapshot.</span></div>
            ${summary.sourceType !== "live-scan" ? '<div class="small text-warning-emphasis mt-2"><i class="bi bi-info-circle me-1"></i>Sin coincidencia en inventario suma 35 puntos al riesgo.</div>' : ""}`;

        const calculationLabel = summary.lastRematchAtUtc
            ? `Recalculado: ${formatDateTime(summary.lastRematchAtUtc)}`
            : `Capturado: ${formatDateTime(summary.observedAtUtc)}`;
        document.getElementById("matching-calculation-label").textContent = calculationLabel;
    };

    const buildSortableHeader = (label, sortKey) => {
        const sortBy = latestPage?.sortBy || "risk";
        const direction = latestPage?.sortDirection || "desc";
        const active = sortBy === sortKey ? "is-active" : "";
        const icon = sortBy === sortKey
            ? (direction === "asc" ? '<i class="bi bi-arrow-up"></i>' : '<i class="bi bi-arrow-down"></i>')
            : '<i class="bi bi-arrow-down-up"></i>';
        return `<button type="button" class="telemetry-sort-button ${active}" data-sort="${sortKey}">${label} ${icon}</button>`;
    };

    const toggleSort = (currentSortBy, currentDirection, nextSortBy) =>
        currentSortBy === nextSortBy ? (currentDirection === "asc" ? "desc" : "asc") : "asc";

    const renderTable = (data) => {
        const items = Array.isArray(data?.items) ? data.items : [];
        const totalCount = Number(data?.totalCount) || 0;
        const page = Number(data?.page) || 1;
        const totalPages = Number(data?.totalPages) || 1;
        latestPage = data;

        if (items.length === 0) {
            table.innerHTML = '<div class="text-muted p-4 text-center">No se encontraron dispositivos con esos filtros.</div>';
        } else {
            const sortBy = data?.sortBy || "risk";
            const direction = data?.sortDirection || "desc";
            table.innerHTML = `
                <div class="telemetry-table-wrap table-responsive data-table-card">
                    <table class="table align-middle table-sm">
                        <thead>
                            <tr>
                                <th>${buildSortableHeader("Equipo", "deviceName")}</th>
                                <th>Usuario</th>
                                <th>IP</th>
                                <th>S/N</th>
                                <th>Método</th>
                                <th>Inventario</th>
                                <th>${buildSortableHeader("Riesgo", "risk")}</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map((item) => `
                                <tr>
                                    <td data-label="Equipo">
                                        <div class="fw-semibold">${item.deviceName || item.hostName || "Sin nombre"}</div>
                                        <div class="small text-muted">${item.hostName || ""}</div>
                                    </td>
                                    <td data-label="Usuario">${item.username || ""}</td>
                                    <td data-label="IP">${item.ipAddress || ""}</td>
                                    <td data-label="S/N">${item.serialNumber || "sin S/N"}</td>
                                    <td data-label="Método"><span class="badge bg-secondary-subtle text-secondary-emphasis">${item.matched ? formatKeyLabel(item.matchKey) : "—"}</span></td>
                                    <td data-label="Inventario">
                                        ${item.matched
                                            ? `<div class="small fw-semibold">${item.inventoryItemNumber || item.inventorySerial || "Ítem"}</div>
                                               <div class="small text-muted">${item.inventoryDescription || item.inventorySerial || ""}</div>
                                               <div class="small">${item.inventoryResponsibleUser || "-"}${item.inventoryEmail ? ` · ${item.inventoryEmail}` : ""}</div>
                                               <div class="small text-muted">${item.inventoryAssignedBuildingExternalId || item.buildingExternalId || "-"}${item.inventoryAssignedRoomExternalId || item.roomExternalId ? ` · ${item.inventoryAssignedRoomExternalId || item.roomExternalId}` : ""}</div>`
                                            : '<span class="text-muted small">sin registro en inventario</span>'}
                                    </td>
                                    <td data-label="Riesgo">${riskPill(item.riskLevel, item.riskScore)}</td>
                                </tr>`).join("")}
                        </tbody>
                    </table>
                </div>`;

            table.querySelectorAll("[data-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextSortBy = button.getAttribute("data-sort") || "risk";
                    const nextDirection = toggleSort(latestPage?.sortBy || "risk", latestPage?.sortDirection || "desc", nextSortBy);
                    loadMatches(1, nextSortBy, nextDirection);
                });
            });
        }

        const previousDisabled = page <= 1 ? "disabled" : "";
        const nextDisabled = page >= totalPages ? "disabled" : "";
        pagination.innerHTML = `
            <button type="button" class="btn btn-outline-secondary btn-sm" ${previousDisabled} data-page="${page - 1}">Anterior</button>
            <span class="align-self-center small text-muted">Página ${page} de ${totalPages} (${totalCount})</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" ${nextDisabled} data-page="${page + 1}">Siguiente</button>`;

        pagination.querySelectorAll("[data-page]").forEach((button) => {
            button.addEventListener("click", () => {
                const nextPage = Number(button.getAttribute("data-page"));
                if (Number.isFinite(nextPage) && nextPage >= 1) {
                    loadMatches(nextPage);
                }
            });
        });
    };

    const renderLoading = () => {
        table.innerHTML = `
            <div class="telemetry-loading-shell">
                <div class="telemetry-loading-content">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <div class="fw-semibold">Cargando cruces...</div>
                </div>
            </div>`;
        pagination.innerHTML = "";
    };

    const loadMatches = (page = 1, sortBy, sortDirection) => {
        if (!currentSnapshotId || currentSnapshotId === noSnapshotId) {
            table.textContent = "Selecciona una snapshot para ver el detalle de cruce.";
            pagination.innerHTML = "";
            return;
        }

        renderLoading();

        const params = new URLSearchParams({
            page: String(page),
            pageSize: pageSizeSelect.value || "25",
            search: searchInput.value.trim() || "",
            matchState: activeMatchState,
            riskLevel: riskSelect.value || "",
            sortBy: sortBy || latestPage?.sortBy || "risk",
            sortDirection: sortDirection || latestPage?.sortDirection || "desc"
        });

        fetch(`/api/network-telemetry/snapshots/${currentSnapshotId}/matches?${params.toString()}`, {
            credentials: "include",
            headers: { "Accept": "application/json" }
        })
            .then((response) => {
                if (!response.ok) throw new Error(`La API respondio ${response.status}`);
                return response.json();
            })
            .then(renderTable)
            .catch((error) => {
                console.error("Error cargando cruces:", error);
                table.innerHTML = '<div class="text-danger p-4 text-center">No se pudo cargar el detalle de cruce.</div>';
                pagination.innerHTML = "";
            });
    };

    const loadSummary = () => {
        if (!currentSnapshotId || currentSnapshotId === noSnapshotId) {
            renderSummary(null);
            return;
        }

        const summaryParams = new URLSearchParams();
        const summaryQuery = summaryParams.toString();

        fetch(`/api/network-telemetry/snapshots/${currentSnapshotId}/matching-summary${summaryQuery ? `?${summaryQuery}` : ""}`, {
            credentials: "include",
            headers: { "Accept": "application/json" }
        })
            .then((response) => {
                if (!response.ok) throw new Error(`La API respondio ${response.status}`);
                return response.json();
            })
            .then((summary) => {
                latestSummary = summary;
                renderSummary(summary);
            })
            .catch((error) => {
                console.error("Error cargando resumen:", error);
                latestSummary = null;
                renderSummary(null);
            });
    };

    const onSnapshotChange = () => {
        currentSnapshotId = snapshotSelect.value || noSnapshotId;
        latestPage = null;
        history.replaceState(null, "", `/dashboard/network-telemetry/matching?snapshotId=${currentSnapshotId}`);
        loadSummary();
        loadMatches(1);
    };

    const runRematch = async () => {
        if (!currentSnapshotId || currentSnapshotId === noSnapshotId) {
            await SyntroUI.alert("Selecciona una snapshot primero.");
            return;
        }

        if (!(await SyntroUI.confirm("Se recalcularan las coincidencias de inventario de esta snapshot usando el motor heuristico. Continuar?"))) {
            return;
        }

        rematchBtn.disabled = true;
        rematchBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Recalculando...';

        const rematchParams = new URLSearchParams();
        const rematchQuery = rematchParams.toString();

        fetch(`/api/network-telemetry/snapshots/${currentSnapshotId}/rematch${rematchQuery ? `?${rematchQuery}` : ""}`, {
            method: "POST",
            credentials: "include",
            headers: { "Accept": "application/json" }
        })
            .then((response) => {
                if (!response.ok) throw new Error(`La API respondio ${response.status}`);
                return response.json();
            })
            .then((result) => {
                SyntroUI.alert(`Recalculo completado: ${result.matchedCount} coincidencias, ${result.unmatchedCount} sin coincidir, ${result.changedCount} cambios.`);
                loadSummary();
                loadMatches(1);
            })
            .catch((error) => {
                console.error("Error recalculando coincidencias:", error);
                SyntroUI.alert("No se pudo recalcular las coincidencias.");
            })
            .finally(() => {
                if (rematchBtn) {
                    rematchBtn.disabled = false;
                    rematchBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Recalcular coincidencias';
                }
            });
    };

    let searchTimer = null;
    searchInput.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => loadMatches(1), 350);
    });
    riskSelect.addEventListener("change", () => loadMatches(1));
    pageSizeSelect.addEventListener("change", () => loadMatches(1));
    snapshotSelect.addEventListener("change", onSnapshotChange);
    if (rematchBtn) {
        rematchBtn.addEventListener("click", runRematch);
    }

    snapshotSelect.disabled = false;
    if (rematchBtn) {
        rematchBtn.disabled = false;
    }

    renderSnapshotSelect();

    if (summarySeed && summarySeed.found === true && summarySeed.snapshotId === currentSnapshotId) {
        latestSummary = summarySeed;
        renderSummary(summarySeed);
    } else {
        loadSummary();
    }

    if (initialPageSeed
        && Array.isArray(initialPageSeed.items)
        && initialPageSeed.snapshotId === currentSnapshotId) {
        renderTable(initialPageSeed);
    } else {
        loadMatches(1);
    }
});
</script>
