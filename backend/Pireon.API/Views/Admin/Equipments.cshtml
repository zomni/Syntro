<script>
    function showClassificationDetail(category, source, confidence, detail, description, serialNumber, itemNumber) {
        var body = document.getElementById("classificationDetailBody");
        if (!body) return;

        var sourceLabel = source === "ml"
            ? '<span class="badge bg-success-subtle text-success-emphasis fs-6">ML' + (confidence ? " " + confidence : "") + '</span>'
            : '<span class="badge bg-light text-muted fs-6">Reglas</span>';

        var detailSection = "";
        if (detail) {
            detailSection = '<div class="alert alert-light border py-2 mb-3">'
                + '<h6 class="mb-2"><i class="bi bi-lightbulb me-1"></i>Como se determino</h6>'
                + '<p class="mb-0 small">' + detail.replace(/</g, "&lt;").replace(/>/g, "&gt;") + '</p>'
                + '</div>';
        }

        var categoriesConfig = [
            { name: "pc", label: "PC", tokens: "NOTEBOOK, DESKTOP, THINKPAD, AIO, OPTIPLEX" },
            { name: "printer", label: "Impresora", tokens: "IMPRESORA, PRINTER" },
            { name: "scanner", label: "Escaner", tokens: "ESCANER, SCANNER, SCAN" },
            { name: "other", label: "Otros", tokens: "(sin tokens)" }
        ];

        var configHtml = '<h6 class="mb-2 mt-3"><i class="bi bi-gear me-1"></i>Categorias configuradas</h6>'
            + '<table class="table table-sm small mb-0"><thead><tr><th>Categoria</th><th>Tokens</th></tr></thead><tbody>'
            + categoriesConfig.map(function(c) {
                return '<tr><td>' + c.label + '</td><td class="text-muted">' + c.tokens + '</td></tr>';
            }).join("")
            + '</tbody></table>';

        body.innerHTML = ''
            + '<div class="d-flex align-items-center gap-3 mb-3">'
            + '  <span class="badge bg-primary fs-5">' + (category || "Sin categoria") + '</span>'
            + '  ' + sourceLabel
            + '</div>'
            + '<div class="row mb-3 text-muted small">'
            + '  <div class="col-md-6"><strong>Equipo:</strong> S/N ' + (serialNumber || "Sin S/N") + ' (Item ' + (itemNumber || "-") + ')</div>'
            + '</div>'
            + detailSection
            + '<h6 class="mb-2"><i class="bi bi-file-text me-1"></i>Descripcion original</h6>'
            + '<div class="bg-light rounded p-2 mb-3 small">' + (description || "Sin descripcion").replace(/</g, "&lt;").replace(/>/g, "&gt;") + '</div>'
            + configHtml;
    }
</script>

<script>
(function () {
    var TILE = 256;
    var SIZE = 256;                 // tamaño visible del tooltip (px) - compacto
    var PAD = 18;                   // margen alrededor de la forma dentro del canvas
    var MIN_ZOOM = 14;
    var MAX_ZOOM = 19;
    var DEFAULT_ZOOM = 17;
    var TILE_SERVERS = ['a', 'b', 'c'];
    var tileImgCache = {};
    var siblingsPromise = null;
    var renderToken = 0;
    var lastRender = null;
    var showDelay = null;
    var hideDelay = null;
    var currentBtn = null;
    var tooltip = null;
    var geometryCache = {};
    var currentZoom = DEFAULT_ZOOM;

    function lonToTileX(lng, z) { return (lng + 180) / 360 * Math.pow(2, z); }
    function latToTileY(lat, z) {
        var rad = lat * Math.PI / 180;
        return (1 - Math.log(Math.tan(rad) + 1 / Math.cos(rad)) / Math.PI) / 2 * Math.pow(2, z);
    }
    function lngToPx(lng, z) { return lonToTileX(lng, z) * TILE; }
    function latToPx(lat, z) { return latToTileY(lat, z) * TILE; }

    function buildTooltip() {
        var el = document.createElement('div');
        el.style.cssText = 'position:fixed;z-index:9999;background:#fff;border-radius:10px;box-shadow:0 6px 28px rgba(0,0,0,0.3);overflow:hidden;opacity:0;transition:opacity .18s ease;display:none;pointer-events:auto;';
        var viewport = document.createElement('div');
        viewport.style.cssText = 'width:' + SIZE + 'px;height:' + SIZE + 'px;position:relative;overflow:hidden;background:linear-gradient(180deg,#eef2f5,#dde6eb);';
        var tiles = document.createElement('div');
        tiles.setAttribute('data-role', 'tiles');
        tiles.style.cssText = 'position:absolute;top:0;left:0;';
        viewport.appendChild(tiles);
        var canvas = document.createElement('canvas');
        canvas.setAttribute('data-role', 'canvas');
        canvas.width = SIZE;
        canvas.height = SIZE;
        canvas.style.cssText = 'position:absolute;top:0;left:0;width:' + SIZE + 'px;height:' + SIZE + 'px;pointer-events:none;z-index:2;';
        viewport.appendChild(canvas);
        el.appendChild(viewport);
        var label = document.createElement('div');
        label.setAttribute('data-role', 'label');
        label.className = 'small fw-semibold p-1 text-center text-truncate';
        label.style.cssText = 'color:#0f172a;max-width:' + SIZE + 'px;position:relative;z-index:3;';
        el.appendChild(label);
        document.body.appendChild(el);
        return el;
    }

    function tileUrl(col, row, z, server) {
        return 'https://' + server + '.tile.openstreetmap.org/' + z + '/' + col + '/' + row + '.png';
    }

    function placeTile(layer, col, row, z) {
        var hash = z + '/' + col + '/' + row;
        var srv = TILE_SERVERS[((col % 3) + 3) % 3];
        var src = tileUrl(col, row, z, srv);
        var img = tileImgCache[hash];
        if (!img) {
            img = new Image();
            img.loading = 'eager';
            img.draggable = false;
            img._retried = false;
            img._altSrc = tileUrl(col, row, z, TILE_SERVERS[(TILE_SERVERS.indexOf(srv) + 1) % 3]);
            img.onerror = function () {
                if (!img._retried) {
                    img._retried = true;
                    img.src = img._altSrc;
                } else {
                    img.style.visibility = 'hidden';
                    delete tileImgCache[hash];
                }
            };
            tileImgCache[hash] = img;
        }
        img.style.cssText = 'position:absolute;left:' + (col * TILE) + 'px;top:' + (row * TILE) + 'px;width:' + TILE + 'px;height:' + TILE + 'px;display:block;user-select:none;';
        img.style.visibility = 'visible';
        img.src = src;
        layer.appendChild(img);
    }

    function drawMarker(ctx, sx, sy) {
        ctx.beginPath();
        ctx.arc(sx, sy - 8, 7, 0, Math.PI * 2);
        ctx.fillStyle = '#e11d48';
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2.5;
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(sx - 5, sy - 3);
        ctx.lineTo(sx, sy + 5);
        ctx.lineTo(sx + 5, sy - 3);
        ctx.fillStyle = '#e11d48';
        ctx.fill();
    }

    function drawPolygonOnCanvas(ctx, geometry, centerPxX, centerPxY) {
        if (!geometry || !geometry.coordinates) return;
        var rings = geometry.type === 'Polygon' ? geometry.coordinates
            : (geometry.type === 'MultiPolygon'
                ? geometry.coordinates.reduce(function (all, polygon) { return all.concat(polygon); }, [])
                : []);
        if (!Array.isArray(rings) || rings.length === 0) return;

        var drawRings = [];
        rings.forEach(function (ring) {
            if (!Array.isArray(ring) || ring.length < 3) return;
            var pts = ring.map(function (c) {
                return [
                    SIZE / 2 + (lngToPx(c[0], currentZoom) - centerPxX),
                    SIZE / 2 + (latToPx(c[1], currentZoom) - centerPxY)
                ];
            });
            drawRings.push(pts);
        });
        if (drawRings.length === 0) return;

        ctx.beginPath();
        drawRings.forEach(function (pts) {
            pts.forEach(function (p, i) {
                if (i === 0) ctx.moveTo(p[0], p[1]);
                else ctx.lineTo(p[0], p[1]);
            });
            ctx.closePath();
        });
        ctx.fillStyle = 'rgba(51, 136, 255, 0.18)';
        ctx.fill('evenodd');
        ctx.strokeStyle = '#3388ff';
        ctx.lineWidth = 2.5;
        ctx.stroke();
    }

    function geometryBBox(geometry) {
        var rings = geometry.type === 'Polygon' ? geometry.coordinates
            : (geometry.type === 'MultiPolygon' ? geometry.coordinates.flat() : []);
        var minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity;
        (rings || []).forEach(function (ring) {
            ring.forEach(function (c) {
                var lng = c[0], lat = c[1];
                if (lng < minLng) minLng = lng;
                if (lng > maxLng) maxLng = lng;
                if (lat < minLat) minLat = lat;
                if (lat > maxLat) maxLat = lat;
            });
        });
        return { minLng: minLng, maxLng: maxLng, minLat: minLat, maxLat: maxLat };
    }

    function computeFitZoom(bbox) {
        var avgLat = (bbox.minLat + bbox.maxLat) / 2;
        var rad = avgLat * Math.PI / 180;
        var cos = Math.max(0.1, Math.cos(rad));
        var spanLng = (bbox.maxLng - bbox.minLng) / 360 * 256;
        var spanLat = (bbox.maxLat - bbox.minLat) / 360 * 256 / cos;
        var target = SIZE - 2 * PAD;
        var z = Math.floor(Math.log2(target / Math.max(Math.max(spanLng, spanLat), 0.0001)));
        if (z < MIN_ZOOM) z = MIN_ZOOM;
        if (z > MAX_ZOOM) z = MAX_ZOOM;
        return z;
    }

    function fetchGeometry(buildingId) {
        if (!buildingId) return Promise.resolve(null);
        if (geometryCache[buildingId]) return Promise.resolve(geometryCache[buildingId]);
        var url = '/api/synced-buildings/' + encodeURIComponent(buildingId) + '/geometry';
        return fetch(url, { credentials: 'include', cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                geometryCache[buildingId] = data || null;
                return data;
            })
            .catch(function () { return null; });
    }

    function getSiblings() {
        if (siblingsPromise) return siblingsPromise;
        siblingsPromise = fetch('/api/synced-buildings', { credentials: 'include', cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .catch(function () { return []; });
        return siblingsPromise;
    }

    function drawNeighborContext(ctx, R) {
        if (!R || R.token !== renderToken) return;
        if (!R.siblings || R.siblings.length === 0) return;
        var near = [];
        R.siblings.forEach(function (b) {
            if (!b || !b.externalId || b.externalId === R.targetId) return;
            var lat = Number(b.centroidLatitude), lng = Number(b.centroidLongitude);
            if (!isFinite(lat) || !isFinite(lng) || (lat === 0 && lng === 0)) return;
            var sx = SIZE / 2 + (lngToPx(lng, R.zoom) - R.cpx);
            var sy = SIZE / 2 + (latToPx(lat, R.zoom) - R.cpy);
            if (sx < -12 || sx > SIZE + 12 || sy < -12 || sy > SIZE + 12) return;
            near.push({ b: b, sx: sx, sy: sy });
        });
        if (near.length === 0) return;
        near.forEach(function (n) {
            ctx.beginPath();
            ctx.arc(n.sx, n.sy, 3, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(30, 60, 90, 0.34)';
            ctx.fill();
        });
        near.slice(0, 9).forEach(function (n) {
            var name = String(n.b.displayName || n.b.shortName || n.b.externalId || '');
            if (name.length > 17) name = name.slice(0, 16) + '…';
            ctx.font = '7.5px system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'bottom';
            ctx.fillStyle = 'rgba(20, 45, 70, 0.5)';
            ctx.fillText(name, n.sx, n.sy - 7);
        });
    }

    function renderPreview(btn, geometry, siblings) {
        var lat = parseFloat(btn.dataset.lat);
        var lng = parseFloat(btn.dataset.lng);
        var targetId = btn.dataset.buildingId || '';

        if (!tooltip) tooltip = buildTooltip();
        var tiles = tooltip.querySelector('[data-role="tiles"]');
        var canvas = tooltip.querySelector('[data-role="canvas"]');
        var ctx = canvas.getContext('2d');
        tiles.innerHTML = '';

        var cz, clng, clat, hasFit = false;
        if (geometry && geometry.coordinates) {
            var bbox = geometryBBox(geometry);
            if (isFinite(bbox.minLng) && isFinite(bbox.minLat) && bbox.minLng <= bbox.maxLng && bbox.minLat <= bbox.maxLat) {
                cz = computeFitZoom(bbox);
                clng = (bbox.minLng + bbox.maxLng) / 2;
                clat = (bbox.minLat + bbox.maxLat) / 2;
                hasFit = true;
            }
        }
        if (!hasFit) {
            if (!isFinite(lat) || !isFinite(lng)) { lat = 0; lng = 0; }
            cz = DEFAULT_ZOOM;
            clng = lng;
            clat = lat;
        }
        currentZoom = cz;

        var cpx = lngToPx(clng, cz);
        var cpy = latToPx(clat, cz);
        tiles.style.transform = 'translate(' + (SIZE / 2 - cpx) + 'px,' + (SIZE / 2 - cpy) + 'px)';

        var c0 = Math.floor((cpx - SIZE / 2) / TILE);
        var c1 = Math.floor((cpx + SIZE / 2 - 1) / TILE);
        var r0 = Math.floor((cpy - SIZE / 2) / TILE);
        var r1 = Math.floor((cpy + SIZE / 2 - 1) / TILE);
        for (var r = r0; r <= r1; r++) {
            for (var c = c0; c <= c1; c++) {
                placeTile(tiles, c, r, cz);
            }
        }

        ctx.clearRect(0, 0, SIZE, SIZE);
        drawNorthArrow(ctx);
        drawPolygonOnCanvas(ctx, geometry, cpx, cpy);
        drawMarker(ctx, SIZE / 2, SIZE / 2);

        var R = { zoom: cz, cpx: cpx, cpy: cpy, targetId: targetId, token: ++renderToken, siblings: siblings || [] };
        lastRender = R;
        if (!siblings) {
            getSiblings().then(function (list) {
                var R2 = { zoom: R.zoom, cpx: R.cpx, cpy: R.cpy, targetId: R.targetId, token: R.token, siblings: list };
                lastRender = R2;
                drawNeighborContext(ctx, R2);
            });
        } else {
            drawNeighborContext(ctx, R);
        }
    }

    function drawNorthArrow(ctx) {
        var nx = SIZE - 14, ny = 16;
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(nx - 5, ny + 5);
        ctx.lineTo(nx, ny - 6);
        ctx.lineTo(nx + 5, ny + 5);
        ctx.closePath();
        ctx.fillStyle = 'rgba(20, 40, 60, 0.5)';
        ctx.fill();
        ctx.font = 'bold 9px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = 'rgba(20, 40, 60, 0.5)';
        ctx.fillText('N', nx, ny + 8);
        ctx.restore();
    }

    function positionTooltip(btn) {
        var tw = tooltip.offsetWidth;
        var th = tooltip.offsetHeight;
        var btnRect = btn.getBoundingClientRect();
        var left = btnRect.left + btnRect.width / 2 - tw / 2;
        var top = btnRect.top - th - 10;
        if (top < 8) { top = btnRect.bottom + 10; }
        if (top + th > window.innerHeight - 8) { top = window.innerHeight - th - 8; }
        if (top < 8) { top = 8; }
        if (left < 8) left = 8;
        if (left + tw > window.innerWidth - 8) left = window.innerWidth - tw - 8;
        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';
    }

    function showPreview(btn) {
        var lat = parseFloat(btn.dataset.lat);
        var lng = parseFloat(btn.dataset.lng);
        var hasPoint = isFinite(lat) && isFinite(lng);
        var name = btn.dataset.buildingName || '';

        if (!tooltip) tooltip = buildTooltip();
        tooltip.querySelector('[data-role="label"]').textContent = name;

        if (hasPoint) {
            renderPreview(btn, null);
        } else {
            var canvas = tooltip.querySelector('[data-role="canvas"]');
            var ctx = canvas.getContext('2d');
            tooltip.querySelector('[data-role="tiles"]').innerHTML = '';
            ctx.clearRect(0, 0, SIZE, SIZE);
            drawNorthArrow(ctx);
        }

        tooltip.style.left = '0px';
        tooltip.style.top = '0px';
        tooltip.style.display = 'block';
        tooltip.style.opacity = '0';
        positionTooltip(btn);
        requestAnimationFrame(function () { tooltip.style.opacity = '1'; });

        fetchGeometry(btn.dataset.buildingId || '').then(function (geometry) {
            if (!geometry) return;
            renderPreview(btn, geometry);
            requestAnimationFrame(function () { tooltip.style.opacity = '1'; });
        });
    }

    function hidePreview() {
        if (tooltip) {
            tooltip.style.opacity = '0';
            setTimeout(function () { if (tooltip) tooltip.style.display = 'none'; }, 180);
        }
    }

    document.addEventListener('mouseenter', function (e) {
        var btn = e.target.closest('[data-map-preview]');
        if (!btn) return;
        if (hideDelay) { clearTimeout(hideDelay); hideDelay = null; }
        if (currentBtn === btn) return;
        if (showDelay) clearTimeout(showDelay);
        currentBtn = btn;
        showDelay = setTimeout(function () { showPreview(btn); }, 280);
    }, true);

    document.addEventListener('mouseleave', function (e) {
        var btn = e.target.closest('[data-map-preview]');
        if (!btn) return;
        if (showDelay) { clearTimeout(showDelay); showDelay = null; }
        hideDelay = setTimeout(function () { currentBtn = null; hidePreview(); }, 350);
    }, true);

    document.addEventListener('mouseenter', function (e) {
        if (!tooltip || !e.target.closest) return;
        if (e.target.closest('[data-map-preview]')) return;
        if (e.target === tooltip || tooltip.contains(e.target)) {
            if (hideDelay) { clearTimeout(hideDelay); hideDelay = null; }
        }
    }, true);

    document.addEventListener('mouseleave', function (e) {
        if (!tooltip || !e.target.closest) return;
        if (e.target === tooltip || tooltip.contains(e.target)) {
            if (!e.relatedTarget || (!tooltip.contains(e.relatedTarget) && !e.relatedTarget.closest('[data-map-preview]'))) {
                hideDelay = setTimeout(function () { currentBtn = null; hidePreview(); }, 250);
            }
        }
    }, true);
})();
</script>














