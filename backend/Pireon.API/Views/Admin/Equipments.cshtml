@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model Pireon.API.ViewModels.AdminInventoryListViewModel
@{
    ViewData["Title"] = "Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole(Pireon.API.Models.AppRoles.Admin);
    var isSuperAdmin = User.IsInRole(Pireon.API.Models.AppRoles.SuperAdmin);
    var requestScheme = string.IsNullOrWhiteSpace(Context?.Request?.Scheme) ? "http" : Context.Request.Scheme;
    var requestHost = Context?.Request?.Host.Host;
    var configuredFrontendUrl = Configuration["FrontendAppUrl"];
    var mapBaseUrl = !string.IsNullOrWhiteSpace(configuredFrontendUrl)
        ? configuredFrontendUrl
        : (!string.IsNullOrWhiteSpace(requestHost)
            ? $"{requestScheme}://{requestHost}:8080"
            : "http://localhost:8080");
    var totalPages = (int)Math.Ceiling((Model.TotalFilteredItems <= 0 ? 1 : Model.TotalFilteredItems) / (double)Model.PageSize);
    var currentPage = Math.Min(Model.Page, totalPages);
    var pageSizeOptions = new[] { 30, 50, 100, 200, 500 };
    var isInconsistencyView = Model.AssignmentFilter == "inconsistent" || Model.OnlyInconsistencies;
    var legacyOnlyInconsistencies = Model.OnlyInconsistencies && Model.AssignmentFilter != "inconsistent";
    var activeFilters = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        activeFilters.Add($"Buscar: {Model.Search}");
    }
    if (!string.IsNullOrWhiteSpace(Model.Category))
    {
        activeFilters.Add($"Categoria: {Model.Category}");
    }
    if (!string.IsNullOrWhiteSpace(Model.Status))
    {
        activeFilters.Add($"Estado: {Model.Status}");
    }
    if (!string.IsNullOrWhiteSpace(Model.AssignmentFilter) && Model.AssignmentFilter != "all")
    {
        var assignmentLabel = Model.AssignmentFilter switch
        {
            "pending" => "Pendientes",
            "assigned" => "Asignados",
            "suggested" => "Con sugerencia",
            "inconsistent" => "Con incongruencias",
            _ => Model.AssignmentFilter
        };
        activeFilters.Add($"Asignacion: {assignmentLabel}");
    }
    if (!string.IsNullOrWhiteSpace(Model.BuildingExternalId))
    {
        var selectedBuilding = Model.Buildings.FirstOrDefault(building => building.ExternalId == Model.BuildingExternalId);
        activeFilters.Add($"Edificio: {(selectedBuilding?.EffectiveDisplayName ?? Model.BuildingExternalId)}");
    }
    if (!string.IsNullOrWhiteSpace(Model.InconsistencyType))
    {
        var inconsistencyLabel = Model.AvailableInconsistencyTypes.FirstOrDefault(option => option.Value == Model.InconsistencyType)?.Label ?? Model.InconsistencyType;
        activeFilters.Add($"Tipo de incongruencia: {inconsistencyLabel}");
    }
    foreach (var columnFilter in Model.ColumnFilters)
    {
        activeFilters.Add($"{columnFilter.Label}: {columnFilter.Value}");
    }
    if (Context?.Request?.Query.ContainsKey("sortBy") == true && !string.IsNullOrWhiteSpace(Model.SortBy))
    {
        activeFilters.Add($"Orden: {Model.SortBy} ({(Model.SortDirection == "desc" ? "desc" : "asc")})");
    }
    if (Model.PageSize != 30)
    {
        activeFilters.Add($"Por pagina: {Model.PageSize}");
    }
    var hasActiveFilters = activeFilters.Count > 0;
    var buildingFloorLookup = Model.Buildings.ToDictionary(
        building => building.ExternalId,
        building =>
        {
            var effectiveFloors = (building.EffectiveFloorsJson ?? string.Empty)
                .Replace("[", string.Empty)
                .Replace("]", string.Empty)
                .Replace("\"", string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .FirstOrDefault();

            return int.TryParse(effectiveFloors, out var parsedFloor) ? parsedFloor : 0;
        });
    var buildingNameLookup = Model.Buildings.ToDictionary(
        building => building.ExternalId,
        building => building.EffectiveDisplayName);
    var selectedOrganizationId = Context?.Request?.Query["organizationId"].ToString();
    var reviewInconsistenciesUrl = Url.Action("Inventory", new
    {
        organizationId = selectedOrganizationId,
        search = Model.Search,
        category = Model.Category,
        status = Model.Status,
        assignment = "inconsistent",
        buildingExternalId = Model.BuildingExternalId,
        sortBy = Model.SortBy,
        sortDirection = Model.SortDirection,
        inconsistencyType = Model.InconsistencyType,
        onlyInconsistencies = false,
        page = 1,
        pageSize = Model.PageSize
    }) ?? "/admin/inventory?assignment=inconsistent";
    var fullInventoryUrl = Url.Action("Inventory", new
    {
        organizationId = selectedOrganizationId,
        search = Model.Search,
        category = Model.Category,
        status = Model.Status,
        assignment = "all",
        buildingExternalId = Model.BuildingExternalId,
        sortBy = Model.SortBy,
        sortDirection = Model.SortDirection,
        inconsistencyType = Model.InconsistencyType,
        onlyInconsistencies = false,
        page = 1,
        pageSize = Model.PageSize
    }) ?? "/admin/inventory";
    var currentInventoryUrl = $"{Context?.Request?.Path}{Context?.Request?.QueryString}";
    string NextSortDirection(string column) => Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
    string SortArrow(string column) => Model.SortBy != column ? "bi bi-dash-lg" : (Model.SortDirection == "asc" ? "bi bi-chevron-down" : "bi bi-chevron-up");
    List<KeyValuePair<string, string?>> BuildInventoryQuery(
        int? pageOverride = null,
        string? sortByOverride = null,
        string? sortDirectionOverride = null,
        string? inconsistencyTypeOverride = null,
        int? pageSizeOverride = null,
        int? removeColumnFilterIndex = null)
    {
        var query = new List<KeyValuePair<string, string?>>();

        void Add(string key, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                query.Add(new KeyValuePair<string, string?>(key, value));
            }
        }

        Add("organizationId", selectedOrganizationId);
        Add("search", Model.Search);
        Add("category", Model.Category);
        Add("status", Model.Status);
        Add("assignment", Model.AssignmentFilter);
        Add("buildingExternalId", Model.BuildingExternalId);
        Add("sortBy", sortByOverride ?? Model.SortBy);
        Add("sortDirection", sortDirectionOverride ?? Model.SortDirection);
        Add("inconsistencyType", inconsistencyTypeOverride ?? Model.InconsistencyType);
        if (legacyOnlyInconsistencies)
        {
            Add("onlyInconsistencies", "true");
        }

        query.Add(new KeyValuePair<string, string?>("page", (pageOverride ?? 1).ToString()));
        query.Add(new KeyValuePair<string, string?>("pageSize", (pageSizeOverride ?? Model.PageSize).ToString()));

        for (var index = 0; index < Model.ColumnFilters.Count; index++)
        {
            if (removeColumnFilterIndex.HasValue && removeColumnFilterIndex.Value == index)
            {
                continue;
            }

            query.Add(new KeyValuePair<string, string?>("filterField", Model.ColumnFilters[index].Field));
            query.Add(new KeyValuePair<string, string?>("filterValue", Model.ColumnFilters[index].Value));
        }

        return query;
    }
    string BuildInventoryUrl(
        int? pageOverride = null,
        string? sortByOverride = null,
        string? sortDirectionOverride = null,
        string? inconsistencyTypeOverride = null,
        int? pageSizeOverride = null,
        int? removeColumnFilterIndex = null)
        => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            "/admin/inventory",
            BuildInventoryQuery(pageOverride, sortByOverride, sortDirectionOverride, inconsistencyTypeOverride, pageSizeOverride, removeColumnFilterIndex));
    string SortUrl(string column) => BuildInventoryUrl(1, column, NextSortDirection(column));
    string PageUrl(int targetPage) => BuildInventoryUrl(targetPage);
    string InconsistencyTypeUrl(string value) => BuildInventoryUrl(1, null, null, value);
    string RemoveColumnFilterUrl(int index) => BuildInventoryUrl(1, null, null, null, null, index);

    string CategoryLabel(string? raw) => raw?.ToLowerInvariant() switch
    {
        "pc" => "PC",
        "printer" => "Impresora",
        "scanner" => "Escáner",
        "other" => "Otros",
        _ => raw ?? ""
    };
    string StatusLabel(string? raw) => raw?.ToLowerInvariant() switch
    {
        "active" => "Activo",
        "maintenance" => "Mantenimiento",
        "inactive" => "Inactivo",
        "stolen" => "Robado",
        "gap" => "Brecha",
        "retired" => "Baja",
        _ => raw ?? ""
    };

    var buildingCentroids = Model.Buildings
        .Where(b => b.CentroidLatitude.HasValue && b.CentroidLongitude.HasValue
                  && (b.CentroidLatitude.Value != 0 || b.CentroidLongitude.Value != 0))
        .ToDictionary(b => b.ExternalId, b => (b.CentroidLatitude!.Value, b.CentroidLongitude!.Value));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header px-4 py-3 rounded-3 d-flex align-items-center gap-3" style="background: linear-gradient(135deg, var(--pi-primary-soft), rgba(45,212,191,0.06)); border-left: 4px solid var(--pi-primary); box-shadow: 0 2px 10px rgba(15,118,110,0.08);">
        <h2 class="fw-bold mb-0 fs-4" style="color: var(--pi-deep);">Inventario importado</h2>
        @if (isSuperAdmin)
        {
            ViewData["OrganizationSelectorCompact"] = true;
            @await Html.PartialAsync("_OrganizationSelector")
        }
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (isAdmin)
        {
            <a href="/admin/inventory/create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Agregar equipo
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<style>
    .dashboard-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .dashboard-kpi-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .dashboard-card:hover .dashboard-kpi-icon {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }
    .fade-in-up {
        animation: fadeUp .5s ease both;
    }
    .fade-in-up-d1 { animation-delay: .05s; }
    .fade-in-up-d2 { animation-delay: .1s; }
    .fade-in-up-d3 { animation-delay: .15s; }
    .fade-in-up-d4 { animation-delay: .2s; }
    .fade-in-up-d5 { animation-delay: .25s; }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .table-sort-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }
    .table-sort-link:hover {
        color: inherit;
        text-decoration: none;
    }
    .table-sort-link .sort-icon {
        font-size: 0.72rem;
        line-height: 1;
        flex: 0 0 auto;
    }
    .table-sort-button {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--bs-dark);
        font-weight: 600;
        padding: 0;
        border: 0;
        background: transparent;
    }
    .table-sort-button:hover,
    .table-sort-button:focus {
        color: var(--bs-dark);
        box-shadow: none;
    }
    .table-fixed-layout {
        table-layout: fixed;
        width: 100%;
    }
    .table-fixed-layout th,
    .table-fixed-layout td {
        white-space: normal;
        word-break: break-word;
        vertical-align: top;
    }
    .inventory-filter-panel {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1rem;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
        padding: 1.25rem;
    }
    .inventory-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 0.8rem;
        border-radius: 0.9rem;
        border: 1px solid rgba(14, 116, 144, 0.18);
        background: #ffffff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
    }
    .inventory-filter-chip.passive {
        border-color: rgba(148, 163, 184, 0.24);
    }
    .inventory-filter-chip .chip-label {
        color: #0f766e;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .inventory-filter-chip .chip-value {
        color: #0f172a;
        font-weight: 600;
    }
    .inventory-filter-chip .chip-remove {
        color: #ea580c;
        text-decoration: none;
        font-size: 0.95rem;
        line-height: 1;
    }
    .inventory-filter-fixed {
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 0.9rem;
        background: #fff;
        padding: 0.85rem;
        height: 100%;
    }
    .inventory-filter-fixed .filter-title {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #475569;
        margin-bottom: 0.55rem;
    }
    .inventory-filter-active-bar {
        border: 1px dashed rgba(14, 116, 144, 0.18);
        border-radius: 0.9rem;
        background: rgba(255, 255, 255, 0.85);
        padding: 0.85rem;
    }
</style>


<div class="row g-4 mb-4">
    <div class="col-xl col-md-6 fade-in-up fade-in-up-d1">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-primary bg-opacity-10">
                        <i class="bi bi-pc-display text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total</div>
                        <div class="fs-3 fw-bold">@Model.TotalItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-6 fade-in-up fade-in-up-d2">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-success bg-opacity-10">
                        <i class="bi bi-check2-circle text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Asignados</div>
                        <div class="fs-3 fw-bold">@Model.AssignedItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-6 fade-in-up fade-in-up-d3">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-warning bg-opacity-10">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pendientes</div>
                        <div class="fs-3 fw-bold">@Model.PendingItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-6 fade-in-up fade-in-up-d4">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-info bg-opacity-10">
                        <i class="bi bi-lightbulb text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Con sugerencia</div>
                        <div class="fs-3 fw-bold">@Model.SuggestedItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-12 fade-in-up fade-in-up-d5">
        <div class="card dashboard-card">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-danger bg-opacity-10">
                        <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Con incongruencias</div>
                        <div class="fs-3 fw-bold">@Model.InconsistentItems</div>
                    </div>
                </div>
                <div>
                    @if (isInconsistencyView)
                    {
                        <a href="@fullInventoryUrl"
                            class="btn btn-sm btn-outline-secondary"
                           title="Ver todo el inventario"
                           aria-label="Ver todo el inventario">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                    else if (Model.InconsistentItems > 0)
                    {
                        <a href="@reviewInconsistenciesUrl"
                           class="btn btn-sm btn-outline-danger"
                           title="Revisar incongruencias"
                           aria-label="Revisar incongruencias">
                            <i class="bi bi-search"></i>
                        </a>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-outline-secondary disabled" title="Sin incongruencias detectadas" aria-hidden="true">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center gap-1 mb-2">
            <button class="btn btn-sm btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#inventoryFilterPanel"
                    aria-expanded="@(hasActiveFilters ? "true" : "false")">
                <i class="bi bi-funnel me-1"></i> Filtros
                @if (hasActiveFilters)
                {
                    <span class="badge bg-primary ms-1">@activeFilters.Count</span>
                }
            </button>
            @if (hasActiveFilters)
            {
                <a href="/admin/inventory" class="btn btn-sm btn-outline-danger" title="Limpiar filtros" aria-label="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>

        @if (hasActiveFilters)
        {
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var columnFilter in Model.ColumnFilters.Select((filter, index) => new { filter, index }))
                {
                    <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1">
                        @columnFilter.filter.Label: @columnFilter.filter.Value
                        <a href="@RemoveColumnFilterUrl(columnFilter.index)" class="text-danger ms-1" title="Quitar filtro" aria-label="Quitar filtro" style="font-size:0.65rem;">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </span>
                }
                @foreach (var filter in activeFilters.Where(filter => !Model.ColumnFilters.Any(columnFilter => $"{columnFilter.Label}: {columnFilter.Value}" == filter)))
                {
                    <span class="badge bg-light text-muted border">@filter</span>
                }
            </div>
        }

        <div class="collapse" id="inventoryFilterPanel">
            <form method="get" action="/admin/inventory" class="inventory-filter-panel pt-2 border-top">
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                <input type="hidden" name="inconsistencyType" value="@Model.InconsistencyType" />
                @foreach (var columnFilter in Model.ColumnFilters)
                {
                    <input type="hidden" name="filterField" value="@columnFilter.Field" />
                    <input type="hidden" name="filterValue" value="@columnFilter.Value" />
                }

                <div class="row g-3">
                    <div class="col-xl-3 col-lg-6">
                        <div class="inventory-filter-fixed position-relative js-autocomplete">
                            <div class="filter-title">Busqueda general</div>
                            <input type="text"
                                   name="search"
                                   value="@Model.Search"
                                   data-autocomplete-endpoint="/dashboard/suggestions/inventory"
                                   data-autocomplete-min="2"
                                   class="form-control"
                                   placeholder="S/N, descripcion, usuario, IP..." />
                            <div class="list-group position-absolute w-100 shadow-sm js-autocomplete-list" style="z-index: 1050; display: none;"></div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-6">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Categoria</div>
                            <select name="category" class="form-select">
                                <option value="">Todas</option>
                                @foreach (var option in Model.Categories)
                                {
                                    <option value="@option" selected="@(Model.Category == option)">@CategoryLabel(option)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-6">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Estado</div>
                            <select name="status" class="form-select">
                                <option value="">Todos</option>
                                @foreach (var option in Model.Statuses)
                                {
                                    <option value="@option" selected="@(Model.Status == option)">@StatusLabel(option)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-6">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Asignacion</div>
                            <select name="assignment" class="form-select">
                                <option value="pending" selected="@(Model.AssignmentFilter == "pending")">Pendientes</option>
                                <option value="assigned" selected="@(Model.AssignmentFilter == "assigned")">Asignados</option>
                                <option value="suggested" selected="@(Model.AssignmentFilter == "suggested")">Con sugerencia</option>
                                <option value="inconsistent" selected="@(Model.AssignmentFilter == "inconsistent" || (Model.AssignmentFilter == "all" && isInconsistencyView))">Con incongruencias</option>
                                <option value="all" selected="@(Model.AssignmentFilter == "all" && !isInconsistencyView)">Todos</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Edificio fijo</div>
                            <select name="buildingExternalId" class="form-select">
                                <option value="">Todos</option>
                                @foreach (var building in Model.Buildings)
                                {
                                    <option value="@building.ExternalId" selected="@(Model.BuildingExternalId == building.ExternalId)">
                                        @building.EffectiveDisplayName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-6">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Agregar filtro por columna</div>
                            <div class="d-flex gap-2">
                                <select name="newFilterField" class="form-select">
                                    <option value="">Columna...</option>
                                    @foreach (var option in Model.AvailableColumnFilters)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                                <input type="text" name="newFilterValue" class="form-control" placeholder="Valor..." />
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-3">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Por pagina</div>
                            <select name="pageSize" class="form-select js-page-size-select">
                                @foreach (var size in pageSizeOptions)
                                {
                                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-6 col-lg-9">
                        <div class="inventory-filter-fixed">
                            <div class="filter-title">Acciones</div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                                    <i class="bi bi-check2 me-1"></i> Aplicar
                                </button>
