<script>
(() => {
  const bindSuggestions = (inputSelector, listId, endpoint) => {
    const input = document.querySelector(inputSelector);
    const list = document.getElementById(listId);
    if (!input || !list) {
      return;
    }

    let timer = null;
    input.addEventListener("input", () => {
      const query = input.value.trim();
      if (timer) {
        clearTimeout(timer);
      }

      timer = window.setTimeout(async () => {
        if (!query) {
          list.innerHTML = "";
          return;
        }

        try {
          const response = await fetch(`${endpoint}?query=${encodeURIComponent(query)}`, {
            headers: { "Accept": "application/json" },
          });
          if (!response.ok) {
            return;
          }

          const data = await response.json();
          list.innerHTML = "";
          (data || []).forEach((value) => {
            if (!value) return;
            const option = document.createElement("option");
            option.value = value;
            list.appendChild(option);
          });
        } catch (error) {
          console.warn("No se pudo cargar sugerencias de ubicaciones.", error);
        }
      }, 200);
    });
  };

  bindSuggestions('input[name="search"]', "locationSearchSuggestions", "/dashboard/suggestions/locations");
  bindSuggestions('input[name="campus"]', "campusSearchSuggestions", "/dashboard/suggestions/campus");
})();
</script>

