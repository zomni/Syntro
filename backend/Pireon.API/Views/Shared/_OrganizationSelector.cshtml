@using Pireon.API.Models
@using Pireon.API.Services
@{
    var organizations = ViewData["SelectableOrganizations"] as IReadOnlyList<Organization> ?? Array.Empty<Organization>();
    var effectiveOrganizationId = ViewData["EffectiveOrganizationId"] as Guid?;
    var isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
    var selectorName = ViewData["OrganizationSelectorName"] as string ?? "organizationId";
    var selectorId = ViewData["OrganizationSelectorId"] as string ?? "organization-selector";
    var compact = ViewData["OrganizationSelectorCompact"] as bool? ?? false;
    var allowAll = ViewData["OrganizationSelectorAllowAll"] as bool? ?? true;

    var effectiveOrg = organizations.FirstOrDefault(org => effectiveOrganizationId.HasValue && effectiveOrganizationId.Value == org.Id);
    var displayOrg = effectiveOrganizationId.HasValue ? effectiveOrg : null;
    var isAllView = !effectiveOrganizationId.HasValue && isSuperAdmin;
    var badgeColor = isAllView
        ? "#0f766e"
        : (!string.IsNullOrWhiteSpace(displayOrg?.Color) ? displayOrg.Color : "#6c757d");
    var badgeTextColor = OrganizationColorPalette.ReadableText(badgeColor);
}

@if (isSuperAdmin)
{
    <div class="d-flex align-items-center gap-2">
        <select id="@selectorId"
                name="@selectorName"
                class="@(compact ? "form-select form-select-sm" : "form-select")"
                data-organization-selector="true"
                title="Filtrar por organizacion">
            @if (allowAll || !effectiveOrganizationId.HasValue)
            {
                <option value="">Todas las organizaciones</option>
            }
            @foreach (var org in organizations)
            {
                <option value="@org.Id" selected="@(effectiveOrganizationId.HasValue && effectiveOrganizationId.Value == org.Id)">@org.Name</option>
            }
        </select>
        <span class="badge border d-inline-flex align-items-center gap-2"
              style="background-color: @badgeColor; color: @badgeTextColor; border-color: @badgeColor;"
              data-organization-label="true"
              title="Organizacion activa">
            <span class="rounded-circle" style="width: 8px; height: 8px; background-color: @badgeTextColor;"></span>
            @(displayOrg?.Name ?? "TODOS")
        </span>
    </div>
}
else
{
    if (displayOrg is not null)
    {
        <input type="hidden"
               id="@selectorId"
               name="@selectorName"
               value="@displayOrg.Id"
               data-organization-selector="true"
               data-organization-id="@displayOrg.Id" />
        <span class="badge border d-inline-flex align-items-center gap-2 fs-6 py-2 px-3"
              style="background-color: @badgeColor; color: @badgeTextColor; border-color: @badgeColor;"
              data-organization-label="true">
            <i class="bi bi-buildings"></i>@displayOrg.Name
        </span>
    }
}

<script>
    (function () {
        var selector = document.getElementById('@selectorId');
        if (!selector) {
            return;
        }

        function navigateWithOrganization(value) {
            var url = new URL(window.location.href);
            if (value) {
                url.searchParams.set('organizationId', value);
            } else {
                url.searchParams.delete('organizationId');
            }
            window.location.href = url.toString();
        }

        selector.addEventListener('change', function () {
            var value = this.value || '';
            var form = this.closest('form');
            if (form && !this.dataset.jsNavigation) {
                form.submit();
                return;
            }
            navigateWithOrganization(value);
        });
    })();
</script>
