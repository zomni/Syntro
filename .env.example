# Credenciales admin inicial (cumplen política: >=10 caracteres)
ADMIN_EMAIL=admin@syntro.local
ADMIN_PASSWORD=Admin123456!

# Orígenes permitidos
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
FRONTEND_APP_URL=http://localhost:8081

# Frontend
API_BASE_URL=http://localhost:5001

# Auth / MFA
AUTH_USE_LDAP=false
ALLOW_LOCAL_BREAK_GLASS=true
BREAK_GLASS_USERNAMES=ADMIN
AUTO_PROVISION_LDAP_USERS=false
DEFAULT_LDAP_ROLE=viewer

MFA_ISSUER=Syntro
MFA_REQUIRE_FOR_ADMINS=true
MFA_REQUIRE_FOR_NON_ADMINS=false
MFA_PENDING_MINUTES=10
MFA_PERIOD_SECONDS=30
MFA_DIGITS=6
MFA_WINDOW_STEPS=6

# Política de contraseñas
PASSWORD_POLICY_MIN_LENGTH=10
PASSWORD_POLICY_MAX_LENGTH=64
PASSWORD_POLICY_DISALLOW_COMMON_PASSWORDS=true

# Backups
BACKUP_ENABLED=true
BACKUP_PATH=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Telemetría de red (deshabilitado por defecto)
NETWORK_TELEMETRY_ENABLED=false
NETWORK_TELEMETRY_AUTOSCAN=false
NETWORK_TELEMETRY_TIME_ZONE=UTC
NETWORK_TELEMETRY_DISPLAY_TIME_ZONE=UTC
NETWORK_TELEMETRY_DISPLAY_LOCALE=es-CL
NETWORK_TELEMETRY_INGEST_API_KEY=CHANGE_ME

# Formularios / LibreOffice
DELIVERY_FORM_INSTITUTION=
DELIVERY_FORM_TEMPLATE_PATH=
DELIVERY_FORM_SOFFICE_PATH=soffice
